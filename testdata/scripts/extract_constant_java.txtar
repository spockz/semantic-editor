env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXTRACT_CONSTANT=1 SEMEDIT_TEST_JAVA_CONSTRUCTS=1
exec semedit refactor-extract-value --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol MAX --in-function Widget.run() --discriminator '1 + 2' --kind constant
stdout 'Extracted the Java expression into a constant'
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
  int run() {
    return 1 + 2;
  }
}
-- want/Widget.java --
package sample;
class Widget {
  private static final int MAX = 1 + 2;
  int run() {
    return MAX;
  }
}
