# Apply an unpublished body edit, extract its nested return expression, then refine that return in the shared batch overlay.
stdin input.json
exec semedit mcp
stdout '"isError":false'
stdout '"operation":"refactor_extract_value"'
stdout '"status":"applied_working"'
cmp render.go .scratch/want/render.go
exec go test ./...

-- go.mod --
module example.com/extractvariablereturnbatch

go 1.24
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","initializationOptions":{"trust_workspace":true}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":true,"edits":[{"tool":"semantic_replace_body","params":{"file":"render.go","symbol":"Render","body":"if count > 0 { return count + 1 }; return count"}},{"tool":"refactor_extract_value","params":{"file":"render.go","symbol":"selected","in_function":"Render","discriminator":"count + 1"}},{"tool":"semantic_replace_construct","params":{"file":"render.go","kind":"statement/expression","in_function":"Render","discriminator":"return selected","source":"return selected * 2"}}]}}}
-- render.go --
package render

func Render(count int) int {
	if count > 0 {
		return count + 1
	}
	return count
}
-- .scratch/want/render.go --
package render

func Render(count int) int {
	if count > 0 {
		selected := count + 1
		return selected * 2
	}
	return count
}
-- render_test.go --
package render

import "testing"

func TestBatchReturnExtractionUsesSharedOverlay(t *testing.T) {
	if got := Render(2); got != 6 {
		t.Fatalf("Render(2) = %d, want 6", got)
	}
	if got := Render(-2); got != -2 {
		t.Fatalf("Render(-2) = %d, want -2", got)
	}
}
