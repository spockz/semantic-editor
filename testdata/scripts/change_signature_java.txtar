# Java change-signature delegates the ordered signature and caller edits to JDT LS.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_CHANGE_SIGNATURE=1 SEMEDIT_JAVA_ORGANIZE=1
exec semedit refactor-change-signature --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Service.java --symbol 'Service.send(int)' --parameters '[{"source_index":0,"parameter":{"name":"identifier","type":"long"}},{"parameter":{"name":"enabled","type":"boolean"},"argument":"true"}]'
cmp src/Service.java want/Service.java
cmp src/Caller.java want/Caller.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Service.java --
package sample;
class Service {
  void send(int id) {
    System.out.println(id);
  }
}
-- src/Caller.java --
package sample;
class Caller {
  void run(Service service) {
    service.send(7);
  }
}

-- want/Service.java --
package sample;
class Service {
  void send(long identifier, boolean enabled) {
    System.out.println(identifier);
  }
}
-- want/Caller.java --
package sample;
class Caller {
  void run(Service service) {
    service.send(7, true);
  }
}

