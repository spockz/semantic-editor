# Outline a Go directory with visibility, kind, empty-file, test, and exclusion coverage
exec semedit outline --path api
stdout 'Outline of directory_syntax "api" \(complete\): 2 files, 13 declarations\.'
stdout 'Server\.Start'
stdout 'PublicFunction'
stdout 'Server\.Visible'
stdout 'Server\.secretField'
stdout 'Server\.hiddenMethod'
stdout 'api/empty\.go'
cmp api/server.go want/api/server.go
exec semedit outline --path api --include-unexported=false --kind field
stdout 'Server\.Visible'
! stdout 'Server\.secretField'
! stdout 'PublicFunction'
exec semedit outline --path api --include-tests=true
stdout 'TestServer'
exec semedit outline --path api/server_test.go
stdout 'TestServer'
exec semedit outline --path api --kind method
stdout 'Service\.Do'
! semedit outline --path api --kind mystery
stderr 'unknown outline kind'
exec semedit outline --path api/server.go --kind class --kind target
stdout 'Outline of selected_file "api/server\.go"'
exec semedit outline --path api/server.go --kind class --kind function
stdout 'PublicFunction'
exec semedit outline --path .
stdout 'other/extra\.go'
exec semedit outline --path generated.java
stdout 'DirectorySymbol'
exec semedit outline --path generated.java --language go
stdout 'DirectorySymbol'

-- go.mod --
module example.com/readoutline
go 1.23

-- api/server.go --
package api

import (
	"fmt"
	fmtx "encoding/json"
	. "strings"
	_ "net/http/httptest"
	"net/http"
)

type Base[T any] interface{ Get() T }

type Server struct {
	Visible, secretField int
}

func (s *Server) Start() {}
func (s *Server) hiddenMethod() {}
func PublicFunction() {}

type Service interface {
	Base[string]
	Visible() string
	Do(value string, values ...int) (bool, error)
	secretMethod()
}
-- api/empty.go --
// Package api retains even files with no declarations.
package api

-- api/server_test.go --
package api

func TestServer() {}

-- generated.java/source.go --
package generated

func DirectorySymbol() {}
-- other/extra.go --
package other

func OtherPackage() {}
-- vendor/dependency/bad.go --
this is invalid vendor source

-- .scratch/cache/bad.go --
this is invalid scratch source

-- want/api/server.go --
package api

import (
	"fmt"
	fmtx "encoding/json"
	. "strings"
	_ "net/http/httptest"
	"net/http"
)

type Base[T any] interface{ Get() T }

type Server struct {
	Visible, secretField int
}

func (s *Server) Start() {}
func (s *Server) hiddenMethod() {}
func PublicFunction() {}

type Service interface {
	Base[string]
	Visible() string
	Do(value string, values ...int) (bool, error)
	secretMethod()
}
