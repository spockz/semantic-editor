# Golden CLI test verification:
exec semedit replace-body --file main.go --symbol main --body 'tmpl := template.Must(template.New("greeting").Parse("Hello World! Random: {{.}}\n")); _ = tmpl.Execute(os.Stdout, rand.IntN(100))'
exec semedit imports --file main.go --add text/template
cmp main.go want/main.go
exec go run main.go

-- go.mod --
module example.com/templateapp
go 1.23

-- main.go --
package main

func main() {
}

-- want/main.go --
package main

import (
	"math/rand/v2"
	"os"
	"text/template"
)

func main() {
	tmpl := template.Must(template.New("greeting").Parse("Hello World! Random: {{.}}\n"))
	_ = tmpl.Execute(os.Stdout, rand.IntN(100))
}
