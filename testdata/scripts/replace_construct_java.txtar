env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_CONSTRUCTS=1
exec cp want/Widget.java expected.java
exec semedit replace-construct --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --in-function Widget.run --kind if --discriminator ready() --construct-path if[0] --source 'if (ready()) { work(); }'
stdout 'Replaced if construct'
stdout 'if \(ready\(\)\) \{ work\(\); \}'
cmp src/Widget.java expected.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
  void run() {
    if (ready()) { work(); } else { miss(); }
  }
}
-- want/Widget.java --
package sample;
class Widget {
  void run() {
    if (ready()) { work(); }
  }
}
