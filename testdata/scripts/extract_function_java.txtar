env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXTRACT_FUNCTION=1 SEMEDIT_TEST_JAVA_CONSTRUCTS=1
exec semedit extract-function --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol extracted --kind method --in-function Widget.run() --start-line 4 --end-line 4
stdout 'Extracted the Java statements into a method'
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
  void run() {
    consume(1);
  }
}
-- want/Widget.java --
package sample;
class Widget {
  private void extracted() {
    consume(1);
  }
  void run() {
    extracted();
  }
}
