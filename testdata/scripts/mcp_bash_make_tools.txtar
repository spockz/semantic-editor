# Bash and Make MCP tools/list contract: expose lookup and Bash verify without unsupported mutation tools.
stdin input.json
exec semedit mcp --live-reload --enabled-languages=bash,make
stdout '"name":\s*"semantic_lookup"'
stdout '"name":\s*"semantic_verify"'
! stdout '"name":\s*"semantic_replace_construct"'

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}

-- scripts/tool.sh --
f() { :; }

-- Makefile --
all:
	@echo never
