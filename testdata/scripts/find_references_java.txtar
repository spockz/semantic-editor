# Java references include trusted cross-source-set usages and exclude declarations.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_JAVA_REFERENCE_URI=file://$WORK/src/test/java/WidgetTest.java SEMEDIT_JAVA_REFERENCE_LINE=1 SEMEDIT_JAVA_REFERENCE_START=2 SEMEDIT_JAVA_REFERENCE_END=8
exec semedit find-references --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/main/java/Widget.java --symbol Widget
stdout '"file":\s*"[^\"]*/src/test/java/WidgetTest.java"'
stdout '"snippet":\s*"Widget"'
stdout '"complete":\s*false'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/main/java/Widget.java --
class Widget {}

-- src/test/java/WidgetTest.java --
class WidgetTest {
  Widget value = new Widget();
}
