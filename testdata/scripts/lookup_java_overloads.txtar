# Java lookup distinguishes overloads by normalized parameter signatures.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_OVERLOADS=1
exec semedit lookup --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src --symbol OrderService.process
stdout '"qualified_name":\s*"OrderService.process\(Order\)"'
stdout '"qualified_name":\s*"OrderService.process\(Order, boolean\)"'

exec semedit inspect-symbol --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src --symbol OrderService.process
stdout '"qualified_name":\s*"OrderService.process\(Order\)"'
stdout '"qualified_name":\s*"OrderService.process\(Order, boolean\)"'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/OrderService.java --
class OrderService {
  void process(Order o) {}
  void process(Order o, boolean retry) {}
}
