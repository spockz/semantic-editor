module example.com/extracttype

go 1.24
-- cache.go --
package cache

type cache struct {
	entries map[string]int
}
-- use.go --
package cache

func lookup(c *cache, key string) int { return c.entries[key] }
-- .scratch/want/cache.go --
package cache

type cache struct {
	entries map[string]int
}
-- .scratch/want/use.go --
package cache

func lookup(c *cache, key string) int { return c.entries[key] }
