# A same-package field reference outside the selected file refuses without changing either source.
! semedit refactor-extract-type --file cache.go --symbol cacheState --in-type cache --members '[{"file":"cache.go","symbol":"cache.entries"}]' --field state
stderr 'referenced outside the selected file'
cmp cache.go .scratch/want/cache.go
cmp use.go .scratch/want/use.go

