# MCP batch text places a successful typed edit receipt before the full diff body.
stdin input.json
exec semedit mcp
stdout 'Critical result \(JSON\):'
stdout '"operation":"migrate-type"'
stdout '"schema_version":"semedit.edit-receipt/v1"'
stdout '"status":"applied_working"'
cmp settings.go .scratch/want/settings.go
-- go.mod --
module example.com.migratereceipt

go 1.24
-- settings.go --
package sample

type Duration = int64

type Settings struct {
	timeout int64
}
-- .scratch/want/settings.go --
package sample

type Duration = int64

type Settings struct {
	timeout Duration
}
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_migrate_type","params":{"file":"settings.go","symbol":"Settings.timeout","type":"Duration"}}]}}}
