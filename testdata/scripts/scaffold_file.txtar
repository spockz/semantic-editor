# Scaffold new Go files with explicit or inferred package declaration
# 1. Scaffold new file inferring package from non-test siblings
exec semedit scaffold-file --file service/helper.go --package infer
# 2. Scaffold new file with explicit package name
exec semedit scaffold-file --file service/sub/types.go --package sub
# 3. Preserve optional purpose headers in CLI scaffolds
exec semedit scaffold-file --file service/documented.go --package infer --purpose-header '// WHY: This file documents the service package.'
# 4. Reject invalid header syntax before creating the file
! exec semedit scaffold-file --file service/invalid.go --package infer --purpose-header 'type Invalid struct {'
stderr 'invalid purpose header'
! exists service/invalid.go
cmp service/helper.go want/service/helper.go
cmp service/sub/types.go want/service/sub/types.go
cmp service/documented.go want/service/documented.go

-- go.mod --
module example.com/test
go 1.23

-- service/service.go --
package service

type Service struct{}

-- service/service_test.go --
package service_test

-- want/service/helper.go --
package service
-- want/service/sub/types.go --
package sub
-- want/service/documented.go --
// WHY: This file documents the service package.

package service
