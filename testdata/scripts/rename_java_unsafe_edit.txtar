# Java mutation rejects foreign-file edits before writing.
env SEMEDIT_JAVA_UNSAFE=1
! semedit rename --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget --to Gadget
stderr 'invalid Java rename edit'
exec cat src/Widget.java
stdout 'class Widget {}'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --

-- tools/jdtls/config_mac/.keep --

-- src/Widget.java --
class Widget {}

-- original.java --
class Widget {}
