# Insert a direct statement next to one uniquely selected direct call.
exec semedit insert-statement --file server.go --in-function '(*Server).Run' --discriminator 'flush()' --source 'record()' --placement before_construct
cmp server.go .scratch/want/inserted.go

# Ambiguous and shared-line anchors fail before changing source.
! exec semedit insert-statement --file server.go --in-function Two --discriminator 'flush()' --source 'record()' --placement after_construct
stderr 'matches 2 direct statements'
cmp server.go .scratch/want/inserted.go
! exec semedit insert-statement --file server.go --in-function Shared --discriminator 'first()' --source 'record()' --placement after_construct
stderr 'shares a source line'
cmp server.go .scratch/want/inserted.go
! exec semedit insert-statement --file server.go --in-function '(*Server).Run' --discriminator 'flush()' --source 'return' --placement before_construct
stderr 'must be one direct call or simple assignment'
cmp server.go .scratch/want/inserted.go
! exec semedit insert-statement --file server.go --in-function '(*Server).Run' --discriminator 'flush()' --source 'record()' --placement before_construct --expected-revision stale
stderr 'does not match the current selected-file revision'
cmp server.go .scratch/want/inserted.go

-- go.mod --
module example.com/insertstatement

go 1.24
-- server.go --
package server

type Server struct{}

func (s *Server) Run() {
	flush()
}

func Two() {
	flush()
	flush()
}

func Shared() { first(); second() }

func flush() {}
func record() {}
func first() {}
func second() {}
-- .scratch/want/inserted.go --
package server

type Server struct{}

func (s *Server) Run() {
	record()
	flush()
}

func Two() {
	flush()
	flush()
}

func Shared() { first(); second() }

func flush() {}
func record() {}
func first() {}
func second() {}
