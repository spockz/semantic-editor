-- go.mod --
module example.com/extractfunctionparameterassignments

go 1.23
-- update.go --
package sample

import "strings"

var events []string

func first(label string) string { events = append(events, "first"); return label + " " }
func increment(count int) int { events = append(events, "increment"); return count + 1 }
func last(label string) string { events = append(events, "last"); return strings.TrimSpace(label) }

func Update(count int, label string) (string, int) {
	label = first(label)
	count = increment(count)
	label = last(label)
	return label, count
}
-- want/update.go --
package sample

import "strings"

var events []string

func first(label string) string { events = append(events, "first"); return label + " " }
func increment(count int) int   { events = append(events, "increment"); return count + 1 }
func last(label string) string  { events = append(events, "last"); return strings.TrimSpace(label) }

func Update(count int, label string) (string, int) {
	label, count = updateValues(count, label)
	return label, count
}

func updateValues(count int, label string) (string, int) {
	label = first(label)
	count = increment(count)
	label = last(label)
	return label, count
}
