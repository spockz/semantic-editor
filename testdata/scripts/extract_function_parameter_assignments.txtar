-- update_test.go --
package sample

import (
	"reflect"
	"testing"
)

func TestAssignmentExtractionPreservesRuntimeBehavior(t *testing.T) {
	events = nil
	label, count := Update(4, " hi")
	if label != "hi" || count != 5 {
		t.Fatalf("Update() = (%q, %d), want (%q, %d)", label, count, "hi", 5)
	}
	if want := []string{"first", "increment", "last"}; !reflect.DeepEqual(events, want) {
		t.Fatalf("events = %v, want %v", events, want)
	}
	if got := Overwrite("old"); got != "fresh" {
		t.Fatalf("Overwrite() = %q, want %q", got, "fresh")
	}
	if got := AddDuration(3, 4); got != 7 {
		t.Fatalf("AddDuration() = %d, want 7", got)
	}
	if got := ReplacePointer(&State{}, &State{Count: 9}); got.Count != 9 {
		t.Fatalf("ReplacePointer() = %#v, want Count 9", got)
	}
}
-- refusal.go --
package sample

func LocalTarget() {
	local := 0
	local = 1
	println(local)
}

func UnsupportedType(values []int) {
	values = values
	println(values)
}

func Addressed(value int) {
	ptr := &value
	value = 1
	println(value)
	_ = ptr
}

func Captured(value int) {
	use := func() { println(value) }
	value = 1
	println(value)
	_ = use
}

func Mixed(value int) {
	local := 1
	value = 2
	println(local, value)
}

func Tuple(left, right int) {
	left, right = 1, 2
	println(left, right)
}

func Compound(value int) {
	value += 1
	println(value)
}
-- original/refusal.go --
package sample

func LocalTarget() {
	local := 0
	local = 1
	println(local)
}

func UnsupportedType(values []int) {
	values = values
	println(values)
}

func Addressed(value int) {
	ptr := &value
	value = 1
	println(value)
	_ = ptr
}

func Captured(value int) {
	use := func() { println(value) }
	value = 1
	println(value)
	_ = use
}

func Mixed(value int) {
	local := 1
	value = 2
	println(local, value)
}

func Tuple(left, right int) {
	left, right = 1, 2
	println(left, right)
}

func Compound(value int) {
	value += 1
	println(value)
}
-- named.go --
package sample

type Duration int64

func AddDuration(total Duration, step Duration) Duration {
	var current Duration
	current = total + step
	println(current)
	return current
}

type State struct {
	Count int
}

func ReplacePointer(state *State, replacement *State) *State {
	state = replacement
	println(state.Count)
	return state
}
-- want/named.go --
package sample

type Duration int64

func AddDuration(total Duration, step Duration) Duration {
	var current Duration
	current = addDuration(total, step)
	println(current)
	return current
}

func addDuration(total Duration, step Duration) Duration {
	var current Duration
	current = total + step
	return current
}

type State struct {
	Count int
}

func ReplacePointer(state *State, replacement *State) *State {
	state = replacePointer(replacement)
	println(state.Count)
	return state
}

func replacePointer(replacement *State) *State {
	var state *State
	state = replacement
	return state
}
