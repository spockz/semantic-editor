# Java mutation must reject an untrusted workspace before starting JDT LS.
! semedit rename --language java --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget --to Gadget
stderr 'workspace trust required'
exec cat src/Widget.java
stdout 'class Widget {}'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --

-- tools/jdtls/config_mac/.keep --

-- src/Widget.java --
class Widget {}

-- original.java --
class Widget {}
