# Receiver lookup returns its field definition while local bindings remain usage data.
exec semedit lookup --file api/dispatch.go --symbol "Dispatcher.sink"
stdout 'Dispatcher\.sink'
stdout 'api/dispatch\.go:[0-9]+'
stdout 'symbol: Dispatcher\.sink'
! stdout 'Local bindings \(navigation only\)'

exec semedit lookup --file api/dispatch.go --symbol "sink"
stdout 'api/dispatch\.go:[0-9]+'
stdout 'Local bindings \(navigation only\):'
stdout 'api/dispatch\.go:7:20  parameter sink'

-- go.mod --
module example.com/receiver-lookup
go 1.23

-- api/dispatch.go --
package api

type Dispatcher struct {
	sink int
}

func NewDispatcher(sink int) {}

func sink() {}
