# A misspelled extraction owner is suggested without changing source; retry keeps the new helper name.
env SEMEDIT_SUGGESTIONS=generic
cp source.go original.txt
! exec semedit refactor-extract-callable --file source.go --symbol prepareValue --in-function Rennder --kind function --start-line 6 --end-line 7
stderr 'Suggested target: Render'
cmp source.go original.txt
exec semedit refactor-extract-callable --file source.go --symbol prepareValue --in-function Render --kind function --start-line 6 --end-line 7
stdout 'symbol: prepareValue'
cmp source.go want/source.go

-- go.mod --
module example.com/suggestionsextractfunction
go 1.23

-- source.go --
package sample

func consume(int) {}

func Render(count int) {
	consume(count)
	consume(count + 1)
}

-- original.txt --
package sample

func consume(int) {}

func Render(count int) {
	consume(count)
	consume(count + 1)
}

-- want/source.go --
package sample

func consume(int) {}

func Render(count int) {
	prepareValue(count)
}

func prepareValue(count int) {
	consume(count)
	consume(count + 1)
}
