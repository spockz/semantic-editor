env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_IMPLEMENT_CONTRACT=1 SEMEDIT_JAVA_ORGANIZE=1
exec semedit implement-contract --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget --contract Runner --contract-file src/Runner.java --receiver-kind pointer --body-policy panic_stub
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
}
-- src/Runner.java --
package sample;
interface Runner { void run(); }
-- want/Widget.java --
package sample;
class Widget implements Runner {
  @Override
  public void run() {}
}
