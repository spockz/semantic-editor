# Java make-static participates in a buffered batch and reports the working edit.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_MAKE_STATIC=1 SEMEDIT_JAVA_ORGANIZE=1
stdin input.json
exec semedit mcp --enable-batching
stdout '"isError":false'
stdout 'applied_working'
cmp src/Service.java .scratch/want/Service.java
cmp src/Caller.java .scratch/want/Caller.java

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"trust_workspace":true,"auto_organize_imports":false,"edits":[{"tool":"refactor_make_static","params":{"file":"src/Service.java","language":"java","trust_workspace":true,"java_bin":"java","jdtls_home":"tools/jdtls","symbol":"Service.count()"}}]}}}

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Service.java --
package sample;
class Service {
  int count() { return 1; }
}
-- src/Caller.java --
package sample;
class Caller {
  int value = new Service().count();
}

-- .scratch/want/Service.java --
package sample;
class Service {
  static int count(Service receiver) { return 1; }
}
-- .scratch/want/Caller.java --
package sample;
class Caller {
  int value = Service.count(new Service());
}

