env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=constant
exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol RETRY_MAX --in-function run --discriminator '1_i32 + 2_i32' --kind constant
stdout 'Extracted the Rust expression with a rust-analyzer assist'
cmp src/lib.rs want/lib.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/refusal.rs --symbol INVALID --in-function run --discriminator 'make_value()' --kind constant
stderr 'suffixed integer literal expression'
cmp src/refusal.rs original/refusal.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/overflow.rs --symbol INVALID --in-function run --discriminator '255_u8 + 1_u8' --kind constant
stderr 'suffixed integer literal expression'
cmp src/overflow.rs original/overflow.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/shadow.rs --symbol RETRY_MAX --in-function run --discriminator '1_i32 + 2_i32' --kind constant
stderr 'possibly shadowed primitive type "i32"'
cmp src/shadow.rs original/shadow.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/generic.rs --symbol RETRY_MAX --in-function run --discriminator '1_i32 + 2_i32' --kind constant
stderr 'possibly shadowed primitive type "i32"'
cmp src/generic.rs original/generic.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/struct_generic.rs --symbol RETRY_MAX --in-function run --discriminator '1_i32 + 2_i32' --kind constant
stderr 'possibly shadowed primitive type "i32"'
cmp src/struct_generic.rs original/struct_generic.rs
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/main.rs --symbol RETRY_MAX --in-function run --discriminator '1_i32 + 2_i32' --kind constant
stderr 'possibly shadowed primitive type "i32"'
cmp src/main.rs original/main.rs

