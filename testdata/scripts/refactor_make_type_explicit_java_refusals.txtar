# Every rejected native envelope keeps the complete source unchanged.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXPLICIT_TYPE=disabled SEMEDIT_JAVA_ORGANIZE=1
! exec semedit refactor-make-type-explicit --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Service.java --in-function 'Service.count()' --symbol total --expected-revision acb3f3ab91bab42907e4b22dc610bd24cce4d83ee537477215b5b54b19a41d86
stderr 'must be enabled and eager'
cmp src/Service.java original.java
env SEMEDIT_TEST_JAVA_EXPLICIT_TYPE=extra
