# Extract a full-slice range in a caller-owned buffer and preserve its maximum bound and runtime behavior.
mkdir .scratch
stdin input.json
exec semedit mcp --enable-batching
stdout '"isError":false'
stdout '"status":"applied_working"'
cmp service.go .scratch/want/service.go
exec go test ./...

-- go.mod --
module example.com/mcpbatchrangeslicefull

go 1.23
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"edits":[{"tool":"refactor_extract_callable","params":{"file":"service.go","symbol":"walk","in_function":"Walk","kind":"function","start_line":8,"end_line":10}}]}}}
-- service.go --
package sample

type Values []int

var seen []int

func Walk(values Values, low, high, max int) {
	for max, value := range values[low:high:max] {
		record(max, value)
	}
}

func record(index, value int) { seen = append(seen, index*10+value) }
-- service_test.go --
package sample

import (
	"reflect"
	"testing"
)

func TestBatchExtractedFullSliceRange(t *testing.T) {
	seen = nil
	Walk(Values{1, 2, 3, 4}, 1, 3, 4)
	if !reflect.DeepEqual(seen, []int{2, 13}) {
		t.Fatalf("seen = %v, want [2 13]", seen)
	}
}
-- .scratch/want/service.go --
package sample

type Values []int

var seen []int

func Walk(values Values, low, high, max int) {
	walk(values, low, high, max)
}

func walk(values Values, low int, high int, max int) {
	for max, value := range values[low:high:max] {
		record(max, value)
	}
}

func record(index, value int) { seen = append(seen, index*10+value) }
