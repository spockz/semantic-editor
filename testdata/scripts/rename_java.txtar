# Java rename returns a resolved continuation after the fake JDT LS publishes diagnostics.
exec semedit refactor-rename --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget --to Gadget
stdout 'Successfully renamed Gadget.'
exec cat src/Widget.java
stdout 'class Gadget {}'
cmp src/Widget.java want.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --

-- want.java --
class Gadget {}
-- src/Widget.java --
class Widget {}
