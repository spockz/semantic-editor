-- service.go --
package sample

type Counter struct {
	step int
}

func (c *Counter) Adjust(mode int, count int) int {
	switch mode {
	case 1:
		count = count + c.step
	default:
		count = count - c.step
	}
	return count
}
-- want/service.go --
package sample

type Counter struct {
	step int
}

func (c *Counter) Adjust(mode int, count int) int {
	switch mode {
	case 1:
		count = c.addCount(count)
	default:
		count = count - c.step
	}
	return count
}

func (c *Counter) addCount(count int) int {
	count = count + c.step
	return count
}
-- service_test.go --
package sample

import "testing"

func TestBatchSwitchParameterExtraction(t *testing.T) {
	counter := &Counter{step: 3}
	if got := counter.Adjust(1, 5); got != 8 {
		t.Fatalf("Adjust(1, 5) = %d, want 8", got)
	}
	if got := counter.Adjust(0, 5); got != 2 {
		t.Fatalf("Adjust(0, 5) = %d, want 2", got)
	}
}
