# Inspect method-local Java constructs and return a reusable construct_path.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_CONSTRUCTS=1
exec semedit inspect-construct --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --in-function Widget.run --kind if --discriminator ready()
stdout '"construct_path":\s*"if\[0\]"'
stdout 'if \(ready\(\)\) \{ work\(\); \} else \{ miss\(\); \}'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
  void run() {
    if (ready()) { work(); } else { miss(); }
  }
}
