# Inline comments inside a rewritten field read refuse without changing source.
env GOCACHE=$WORK/user-cache/build
env GOMODCACHE=$WORK/user-cache/mod
exec cp owner.go before-owner.txt
! exec semedit refactor-encapsulate-field --file owner.go --symbol owner.value --getter getValue --setter setValue
stderr 'comments inside rewritten field reads'
cmp owner.go before-owner.txt

-- go.mod --
module example.com/encapsulatefieldcomments

go 1.24
-- owner.go --
package sample

type owner struct { value int }

func read(value *owner) int { return value./* keep the field unit */value }
