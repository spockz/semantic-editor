# Extract direct slice factories and prove one evaluation, captured length, shared backing storage, and panic order.
exec semedit refactor-extract-callable --file service.go --symbol walkOnce --in-function Run --kind function --start-line 18 --end-line 18
stdout 'symbol: walkOnce'
exec semedit refactor-extract-callable --file service.go --symbol walkMutation --in-function RunMutation --kind function --start-line 35 --end-line 40
stdout 'symbol: walkMutation'
cmp service.go want/service.go
