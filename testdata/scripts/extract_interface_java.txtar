env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXTRACT_INTERFACE=1 SEMEDIT_JAVA_ORGANIZE=1
exec semedit extract-interface --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --in-type Widget --symbol Measurable --members '[{"file":"src/Widget.java","symbol":"Widget.size(String)"}]'
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
public class Widget {
  public int size(String value) { return value.length(); }
}
-- want/Widget.java --
package sample;
public class Widget implements Measurable {
  public int size(String value) { return value.length(); }
}

interface Measurable {
	public int size(String value);
}
