package sample

func ParenthesizedWrite() {
	x := 0
	(x) = 1
	extractParenthesized()
	_ = x
}

func extractParenthesized() {
	var x int
	x = 2
	println(x)
}
-- behavior_test.go --
package sample

import (
	"reflect"
	"testing"
)

func TestWriteOnlyExtractionPreservesEvaluation(t *testing.T) {
	writeEvents = nil
	WriteOnly()
	if want := []string{"selected"}; !reflect.DeepEqual(writeEvents, want) {
		t.Fatalf("WriteOnly events = %v, want %v", writeEvents, want)
	}
	lastEvents = nil
	LastRead()
	if want := []string{"init", "selected"}; !reflect.DeepEqual(lastEvents, want) {
		t.Fatalf("LastRead events = %v, want %v", lastEvents, want)
	}
	mixedEvents = nil
	Mixed()
	if want := []string{"x", "y"}; !reflect.DeepEqual(mixedEvents, want) {
		t.Fatalf("Mixed events = %v, want %v", mixedEvents, want)
	}
	parallelEvents = nil
	Parallel()
	if want := []string{"x", "y"}; !reflect.DeepEqual(parallelEvents, want) {
		t.Fatalf("Parallel events = %v, want %v", parallelEvents, want)
	}
	events = nil
	global = 0
	UpdateGlobal()
	if global != 1 || !reflect.DeepEqual(events, []string{"global"}) {
		t.Fatalf("UpdateGlobal = (%d, %v), want (1, [global])", global, events)
	}
	panicEvents = nil
	func() {
		defer func() {
			if recover() != "stop" {
				t.Fatal("PanicWrites() did not preserve panic")
			}
		}()
		PanicWrites()
	}()
	if want := []string{"first", "panic"}; !reflect.DeepEqual(panicEvents, want) {
		t.Fatalf("PanicWrites events = %v, want %v", panicEvents, want)
	}
}
