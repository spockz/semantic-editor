package sample

var mixedEvents []string

func mixedEffect(label string) int {
	mixedEvents = append(mixedEvents, label)
	return len(mixedEvents)
}

func Mixed() {
	x := 0
	println(x)
	y := mixWrites()
	println(y)
}

func mixWrites() int {
	var x int
	x, y := mixedEffect("x"), mixedEffect("y")
	_ = x
	return y
}
