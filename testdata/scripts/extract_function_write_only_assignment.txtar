-- write_only.go --
package sample

var writeEvents []string

func recordWrite(label string) int {
	writeEvents = append(writeEvents, label)
	return 1
}

func WriteOnly() {
	x := 0
	println(x)
	x = recordWrite("selected")
	println("done")
}
-- want/write_only.go --
package sample

var writeEvents []string

func recordWrite(label string) int {
	writeEvents = append(writeEvents, label)
	return 1
}

func WriteOnly() {
	x := 0
	println(x)
	writeOnly()
	println("done")
}

func writeOnly() {
	var x int
	x = recordWrite("selected")
	_ = x
}
