-- panic.go --
package sample

var panicEvents []string

func panicWriteEffect(label string) int {
	panicEvents = append(panicEvents, label)
	return len(panicEvents)
}

func panicEffect() int {
	panicEvents = append(panicEvents, "panic")
	panic("stop")
}

func PanicWrites() {
	x, y, z := 0, 0, 0
	println(x, y, z)
	x, y, z = panicWriteEffect("first"), panicEffect(), panicWriteEffect("last")
	println("done")
}
-- want/panic.go --
package sample

var panicEvents []string

func panicWriteEffect(label string) int {
	panicEvents = append(panicEvents, label)
	return len(panicEvents)
}

func panicEffect() int {
	panicEvents = append(panicEvents, "panic")
	panic("stop")
}

func PanicWrites() {
	x, y, z := 0, 0, 0
	println(x, y, z)
	panicWrites()
	println("done")
}

func panicWrites() {
	var x int
	var y int
	var z int
	x, y, z = panicWriteEffect("first"), panicEffect(), panicWriteEffect("last")
	_ = x
	_ = y
	_ = z
}
