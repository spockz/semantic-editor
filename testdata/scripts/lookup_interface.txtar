# Lookup methods declared by and embedded into a package interface.
exec semedit lookup --file api/outer.go --symbol "TransactionalSink.Write"
stdout 'TransactionalSink\.Write'
stdout 'api/base\.go:[0-9]+'
stdout 'symbol: TransactionalSink\.Write'

-- go.mod --
module example.com/interface-lookup
go 1.23

-- api/outer.go --
package api

type TransactionalSink interface {
	Sink
}

-- api/base.go --
package api

type Sink interface {
	Write([]byte) error
}
