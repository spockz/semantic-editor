# A changed import graph refuses potentially panicking map initialization before writing.
! exec semedit refactor-move-declaration --file legacy/widget.go --destination-file api/api.go --symbol Widget --placement file_end
stderr 'refuses dynamic package initialization'
cmp legacy/widget.go .scratch/_want/legacy/widget.go
cmp legacy/init.go .scratch/_want/legacy/init.go
cmp dependency/dependency.go .scratch/_want/dependency/dependency.go
cmp state/state.go .scratch/_want/state/state.go
cmp api/api.go .scratch/_want/api/api.go

-- go.mod --
module example.com/typecrossmapinit

go 1.23

