package legacy

import "example.com/typecrossmapinit/dependency"

type Widget int

func (Widget) Value() int { return dependency.Value() }
-- legacy/init.go --
package legacy

var PanicAtInitialization = map[any]int{[]int{}: 1}
-- api/api.go --
package api
-- dependency/dependency.go --
package dependency

func Value() int { return 1 }
