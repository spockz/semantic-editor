# A Scala extraction and following lookup share the unpublished batch overlay.
env SEMEDIT_TEST_SCALA_EXTRACT_VARIABLE=1
exec materialize-mcp-input input.json
stdin input.expanded.json
exec semedit mcp
stdout '"isError":true'
stdout '"status":"applied_with_diagnostics"'
stdout 'no selected source has a configured verification backend'
stdout '"source_view":"working"'
cmp src/Thing.scala expected.scala

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"refactor_extract_value","params":{"language":"scala","trust_workspace":true,"metals_bin":"@METALS_BIN@","java_bin":"@JAVA_BIN@","java_version":"21","file":"src/Thing.scala","symbol":"total","in_function":"run","discriminator":"1 + 2"}},{"tool":"semantic_lookup","params":{"language":"scala","trust_workspace":true,"metals_bin":"@METALS_BIN@","java_bin":"@JAVA_BIN@","java_version":"21","file":"src/Thing.scala","symbol":"run"}}]}}}
-- src/Thing.scala --
object Thing {
  def run(): Int = consume(1 + 2)
  def consume(value: Int): Int = value
}
-- expected.scala --
object Thing {
  def run(): Int = {
    val total = 1 + 2
    consume(total)
  }
  def consume(value: Int): Int = value
}
