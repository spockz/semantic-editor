# Extract a receiver method through the CLI and verify its parameters, result, source, and behavior.
exec semedit refactor-extract-callable --file counter.go --symbol doubleValue --in-function Counter.Run --kind method --start-line 6 --end-line 7
stdout 'symbol: doubleValue'
cmp counter.go want/counter.go
exec go test ./...

-- go.mod --
module example.com/extractmethod

go 1.23
-- counter.go --
package sample

type Counter struct{ value int }

func (c Counter) Run(delta int) int {
	value := c.value + delta
	value = value * 2
	return value
}
-- want/counter.go --
package sample

type Counter struct{ value int }

func (c Counter) Run(delta int) int {
	value := c.doubleValue(delta)
	return value
}

func (c Counter) doubleValue(delta int) int {
	value := c.value + delta
	value = value * 2
	return value
}
-- counter_test.go --
package sample

import "testing"

func TestRun(t *testing.T) {
	if got := (Counter{value: 3}).Run(4); got != 14 {
		t.Fatalf("Run() = %d, want 14", got)
	}
}
