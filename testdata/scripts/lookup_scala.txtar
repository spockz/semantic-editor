# Lookup through the Scala CLI backend and direct, pinned Metals and Java executables.
exec semedit lookup --language scala --trust-workspace --metals-bin $SEMEDIT_TEST_METALS --java-bin $SEMEDIT_TEST_JAVA --java-version 21 --file src/Widget.scala --symbol Widget
stdout '"file":\s*"src/Widget.scala"'
stdout '"symbol":\s*"Widget"'

-- src/Widget.scala --
object Widget {}
