stdout '"expected_revision": "60663ee998eee2df4d2cd297f943581cf03388ca3272ab486189b23780ea548d"'
exec semedit inspect-construct --file service.go --in-function Emit --kind statement/expression --discriminator 'count = count + 2'
stdout '"construct_path": "1.0.1"'
stdout '"expected_revision": "60663ee998eee2df4d2cd297f943581cf03388ca3272ab486189b23780ea548d"'
exec semedit refactor-extract-callable --file service.go --symbol addCount --in-function Emit --kind function --construct-path 1.0.0 --end-construct-path 1.0.1 --expected-revision 60663ee998eee2df4d2cd297f943581cf03388ca3272ab486189b23780ea548d
cmp service.go want/service.go
