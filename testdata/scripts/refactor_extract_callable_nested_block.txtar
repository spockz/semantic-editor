package sample

func EmitElse(enabled bool) int {
	count := 0
	if enabled {
		count = count + 1
	} else {
		count = count + 2
	}
	return count
}
-- want/service.go --
package sample

func Emit(enabled bool) int {
	count := 0
	if enabled {
		count = addCount(count)
	}
	return count
}

func addCount(count int) int {
	count = count + 1
	count = count + 2
	return count
}
