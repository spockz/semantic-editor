package sample

import "fmt"

func EmitInner(enabled bool) {
	count := 0
	if enabled {
		count = count + 1
		fmt.Println(count)
	}
}
-- counted.go --
package sample

import "fmt"

func EmitCounted() {
	count := 0
	for i := 0; i < 3; i++ {
		fmt.Println(count)
		count = count + 1
	}
}
