# The second native action reads the first action's staged source and revision before one batch publication.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXPLICIT_TYPE=1 SEMEDIT_JAVA_ORGANIZE=1
stdin input.json
exec semedit mcp
stdout '"isError":false'
stdout '"status":"applied_working"'
stdout '"revision":"4de418017a9a8027aef31e4bfddc68e00bcb896a2dd78dee04214a2b568a862e"'
cmp src/Service.java .scratch/want/Service.java

