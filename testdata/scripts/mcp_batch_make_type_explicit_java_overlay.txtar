import java.util.ArrayList;
import java.util.List;
class Service {
  static String choose(int value) { return "int:" + value; }
  static String choose(long value) { return "long:" + value; }
  static String choose(ArrayList<String> value) { return "array:" + value.size(); }
  static String choose(List<String> value) { return "list:" + value.size(); }
  static String count() {
    int total = 1 + 2;
    return choose(total);
  }
  static String count(int seed) { return "other"; }
  static String reference() {
    ArrayList<String> items = new ArrayList<String>();
    items.add("item");
    return choose(items);
  }
  public static void main(String[] args) { System.out.println(count() + "/" + reference()); }
}
