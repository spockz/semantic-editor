# This MCP batch adds a private type then a field against the shared working view and reports buffered application.
stdin input.json
exec semedit mcp --enable-batching
stdout '"isError":false'
stdout 'applied_working'
cmp config.go .scratch/want/config.go

-- go.mod --
module example.com/insertfieldbatch

go 1.24
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_insert_type","params":{"file":"config.go","source":"type options struct{}","access":"private","placement":"file_end"}},{"tool":"semantic_insert_field","params":{"file":"config.go","in_type":"options","symbol":"options.timeout","source":"timeout int","placement":"type_end"}}]}}}
-- config.go --
package config
-- .scratch/want/config.go --
package config

type options struct {
	timeout int
}
