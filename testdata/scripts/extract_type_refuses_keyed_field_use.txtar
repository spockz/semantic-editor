# A typed keyed field use is not rewritten and causes a no-write refusal.
! semedit extract-type --file cache.go --symbol cacheState --in-type cache --members '[{"file":"cache.go","symbol":"cache.entries"}]' --field state
stderr 'non-selector use'
cmp cache.go .scratch/want/cache.go

-- go.mod --
module example.com/extracttypekeyed

go 1.24
-- cache.go --
package cache

type cache struct {
	entries map[string]int
}

var defaultCache = cache{entries: map[string]int{}}
-- .scratch/want/cache.go --
package cache

type cache struct {
	entries map[string]int
}

var defaultCache = cache{entries: map[string]int{}}
