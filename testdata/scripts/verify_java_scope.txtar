# Java scope verification normalizes each selected source through the shared JDT LS session.
env SEMEDIT_JAVA_ORGANIZE=1
exec semedit verify --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --path src --format-selected-file --organize-imports
stdout 'Verification clean: 0 diagnostics.'
cmp src/main/One.java want/One.java
cmp src/test/Two.java want/Two.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/main/One.java --
class One {}

-- src/test/Two.java --
class Two {}
-- want/One.java --
class One {}

-- want/Two.java --
class Two {}
