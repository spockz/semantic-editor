-- nested.go --
package render

func RenderNested(input int) int {
	var first int
	var second int
	if input > 0 {
		first = input + 1
		second = input + 1
	}
	return first + second
}
-- original/nested.go --
package render

func RenderNested(input int) int {
	var first int
	var second int
	if input > 0 {
		first = input + 1
		second = input + 1
	}
	return first + second
}
-- render_test.go --
package render

import "testing"

func TestAssignmentRangePreservesRuntimeResult(t *testing.T) {
	if got := RenderRange(4); got != 10 {
		t.Fatalf("RenderRange(4) = %d, want 10", got)
	}
}
