# Inline one typed direct literal-return call after a preceding child changes the caller overlay.
stdin input.json
exec semedit mcp --live-reload
! stdout '"name"\s*:\s*"semantic_inline_function"'
! stdout '"isError":true'
stdout '"operation":"inline-function"'
stdout '"status":"applied_working"'
cmp caller.go .scratch/want/caller.go
exec go test ./...

-- go.mod --
module example.com/inlinebatch

go 1.24
-- callee.go --
package sample

func adjust() int { return 7 }
-- caller.go --
package sample

func Prelude() int {
	return 1
}

func Run() int { return int(7); return adjust() }
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_replace_body","params":{"file":"caller.go","symbol":"Prelude","body":"return 2"}},{"tool":"semantic_inline_function","params":{"file":"callee.go","symbol":"adjust","call_site":{"file":"caller.go","in_function":"Run","discriminator":"adjust()","expected_revision":"42e0af5579e8990f360b99948332e6a6f62d76df2249134683290d1df8170902"}}}]}}}
-- .scratch/want/caller.go --
package sample

func Prelude() int {
	return 2
}

func Run() int { return int(7); return int(7) }
