package server

type Server struct{}

func (s *Server) Run() int {
	flush()
	return 0
}

func Two() {
	flush()
	flush()
}

func Shared() {
	first()
	second()
}

func flush()        {}
func record()       {}
func first()        {}
func second()       {}
func firstRecord()  {}
func lastRecord()   {}
func returnRecord() {}
func afterFlush()   {}
