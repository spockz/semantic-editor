# Preserve Go full-slice range bounds, capacity semantics, and pre-body panics during extraction.
exec semedit refactor-extract-callable --file service.go --symbol walk --in-function Walk --kind function --start-line 15 --end-line 17
cmp service.go want/service.go.txt
exec semedit refactor-extract-callable --file invalid.go --symbol walkInvalid --in-function WalkInvalid --kind function --start-line 4 --end-line 6
cmp invalid.go want/invalid.go.txt
exec go test ./...

-- go.mod --
module example.com/extractrangeslicefull

go 1.23
-- service.go --
package sample

type Values []int

type Visit struct {
	Index int
	Value int
}

var visits []Visit
var backing Values
var bodyEffects int

func Walk(values Values, low, high, max int) {
	for max, value := range values[low:high:max] {
		record(max, value)
	}
}

func record(index, value int) {
	if index == 0 {
		backing[2] = 77
	}
	visits = append(visits, Visit{Index: index, Value: value})
	bodyEffects++
}
-- invalid.go --
package sample

func WalkInvalid(values Values, low, high, max int) {
	for index := range values[low:high:max] {
		effect(index)
	}
}

func effect(index int) { bodyEffects += index + 1 }
-- service_test.go --
package sample

import (
	"reflect"
	"testing"
)

func TestFullSliceRangeExtractionKeepsCapacityAndBodySemantics(t *testing.T) {
	visits = nil
	bodyEffects = 0
	Walk(nil, 0, 0, 0)
	Walk(Values{}, 0, 0, 0)
	if len(visits) != 0 || bodyEffects != 0 {
		t.Fatalf("nil and empty full-slice ranges ran effects: visits=%v effects=%d", visits, bodyEffects)
	}

	backing = Values{10, 20, 30, 40, 50}
	values := backing[:2]
	visits = nil
	bodyEffects = 0
	Walk(values, 1, 3, 4)
	want := []Visit{{Index: 0, Value: 20}, {Index: 1, Value: 77}}
	if !reflect.DeepEqual(visits, want) || bodyEffects != 2 {
		t.Fatalf("visits=%v effects=%d, want %v and 2 effects", visits, bodyEffects, want)
	}

	invalidCases := []struct {
		name          string
		low, high, max int
	}{
		{name: "negative low", low: -1, high: 0, max: 0},
		{name: "low above high", low: 2, high: 1, max: 3},
		{name: "high above max", low: 0, high: 2, max: 1},
		{name: "max above capacity", low: 0, high: 1, max: 6},
	}
	for _, tc := range invalidCases {
		t.Run(tc.name, func(t *testing.T) {
			bodyEffects = 0
			func() {
				defer func() {
					if recover() == nil {
						t.Error("invalid full-slice bounds did not panic")
					}
				}()
				WalkInvalid(values, tc.low, tc.high, tc.max)
			}()
			if bodyEffects != 0 {
				t.Fatalf("invalid bounds ran %d body effects", bodyEffects)
			}
		})
	}
}
-- want/service.go.txt --
package sample

type Values []int

type Visit struct {
	Index int
	Value int
}

var visits []Visit
var backing Values
var bodyEffects int

func Walk(values Values, low, high, max int) {
	walk(values, low, high, max)
}

func walk(values Values, low int, high int, max int) {
	for max, value := range values[low:high:max] {
		record(max, value)
	}
}

func record(index, value int) {
	if index == 0 {
		backing[2] = 77
	}
	visits = append(visits, Visit{Index: index, Value: value})
	bodyEffects++
}
-- want/invalid.go.txt --
package sample

func WalkInvalid(values Values, low, high, max int) {
	walkInvalid(values, low, high, max)
}

func walkInvalid(values Values, low int, high int, max int) {
	for index := range values[low:high:max] {
		effect(index)
	}
}

func effect(index int) { bodyEffects += index + 1 }
