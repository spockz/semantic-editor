fn consume(value: i32) {
    let previous = SEQUENCE.load(std::sync::atomic::Ordering::SeqCst);
    SEQUENCE.store(previous * 10 + value as usize, std::sync::atomic::Ordering::SeqCst);
}

fn main() {
    run();
    let observed = SEQUENCE.load(std::sync::atomic::Ordering::SeqCst);
    if observed < 12 || observed > 12 {
        std::process::exit(1);
    }
}
-- want-lib.txt --
fn run() {
    extracted();
}

fn extracted() {
    consume(1_i32);
    consume(2_i32);
}

static SEQUENCE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);

fn consume(value: i32) {
    let previous = SEQUENCE.load(std::sync::atomic::Ordering::SeqCst);
    SEQUENCE.store(previous * 10 + value as usize, std::sync::atomic::Ordering::SeqCst);
}

fn main() {
    run();
    let observed = SEQUENCE.load(std::sync::atomic::Ordering::SeqCst);
    if observed < 12 || observed > 12 {
        std::process::exit(1);
    }
}
