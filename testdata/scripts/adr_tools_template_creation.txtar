# adr-tools creates a complete repository-template record that semedit can search and index.
env ADR_DATE=2026-10-21 ADR_TEMPLATE= VISUAL=true
exec adr new Template Created Record
stdout 'docs/adr/0001-template-created-record.md'
cmp docs/adr/0001-template-created-record.md want/0001-template-created-record.md
exec semedit search-adrs --query concise --limit 1
stdout '"id": "ADR-0001"'
stdout '"path": "docs/adr/0001-template-created-record.md"'
exec semedit generate-adr-index
stdout '"status":"synced"'
grep 'ADR-0001.*Template Created Record.*Proposed.*2026-10-21' docs/adr/README.md

-- .adr-dir --
docs/adr
-- docs/adr/README.md --
