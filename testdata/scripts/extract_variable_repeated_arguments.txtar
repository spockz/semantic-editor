package render

var shiftCalls, shiftDefers int

func shiftSink(first, second, third int) {
	shiftCalls++
}

func RenderShift(base, shift int) {
	defer func() { shiftDefers++ }()
	shiftSink(base<<shift, 0, base<<shift)
}
-- want/shift.go --
package render

var shiftCalls, shiftDefers int

func shiftSink(first, second, third int) {
	shiftCalls++
}

func RenderShift(base, shift int) {
	defer func() { shiftDefers++ }()
	shifted := base << shift
	shiftSink(shifted, 0, shifted)
}
