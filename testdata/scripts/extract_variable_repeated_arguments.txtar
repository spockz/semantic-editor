module example.com/extractvariablerepeated

go 1.24
-- pair.go --
package render

var pairValues [2]int

func pairSink(left, right int) {
	pairValues = [2]int{left, right}
}

func RenderPair(count int) {
	pairSink(count + 1, count + 1)
}
-- want/pair.go --
package render

var pairValues [2]int

func pairSink(left, right int) {
	pairValues = [2]int{left, right}
}

func RenderPair(count int) {
	pairValue := count + 1
	pairSink(pairValue, pairValue)
}
