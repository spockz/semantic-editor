-- divide.go --
package render

var divideCalls, divideDefers int

func divideSink(first, second, third int) {
	divideCalls++
}

func RenderDivide(divisor int) {
	defer func() { divideDefers++ }()
	divideSink(10/divisor, 0, 10/divisor)
}
-- want/divide.go --
package render

var divideCalls, divideDefers int

func divideSink(first, second, third int) {
	divideCalls++
}

func RenderDivide(divisor int) {
	defer func() { divideDefers++ }()
	quotient := 10 / divisor
	divideSink(quotient, 0, quotient)
}
