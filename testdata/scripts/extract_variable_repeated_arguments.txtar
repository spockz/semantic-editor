-- implicit_call.go --
package render

type EscapingCount int

var savedCount *EscapingCount

func (count *EscapingCount) Escape() { savedCount = count }
func implicitCallSink(EscapingCount, EscapingCount) {}

func RenderImplicitCall(count EscapingCount) {
	count.Escape()
	implicitCallSink(count+1, count+1)
}
