-- repeated_test.go --
package render

import "testing"

func TestRepeatedArguments(t *testing.T) {
	RenderPair(4)
	if pairValues != [2]int{5, 5} {
		t.Fatalf("pair arguments = %v", pairValues)
	}
	RenderTriple(4)
	if tripleValues != [3]int{5, 5, 5} {
		t.Fatalf("triple arguments = %v", tripleValues)
	}
	RenderNamed(Count(4))
	if namedValues != [2]Count{5, 5} {
		t.Fatalf("named arguments = %v", namedValues)
	}

	assertPanic := func(call func()) {
		t.Helper()
		panicked := false
		func() {
			defer func() { panicked = recover() != nil }()
			call()
		}()
		if !panicked {
			t.Fatal("call did not panic")
		}
	}
	assertPanic(func() { RenderDivide(0) })
	if divideCalls != 0 || divideDefers != 1 {
		t.Fatalf("division effects = calls %d, defers %d", divideCalls, divideDefers)
	}
	assertPanic(func() { RenderShift(1, -1) })
	if shiftCalls != 0 || shiftDefers != 1 {
		t.Fatalf("shift effects = calls %d, defers %d", shiftCalls, shiftDefers)
	}
}
