# Java import requests are staged, then formatted and organized through JDT LS.
env SEMEDIT_JAVA_ORGANIZE=1
exec semedit imports --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --add java.util.List --remove java.util.Set
stdout 'Successfully organized imports.'
cmp src/Widget.java want.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;

import java.util.Set;
import java.time.Instant;

class Widget {}
-- want.java --
package sample;

import java.time.Instant;
import java.util.List;

class Widget {}
