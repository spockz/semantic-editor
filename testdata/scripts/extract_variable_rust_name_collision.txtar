env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=1
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol total --in-function run --discriminator '1 + 2'
stderr 'shadowing conflict'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "extract-variable-collision-fixture"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
fn run() {
    let total = 10;
    consume(1 + 2);
}

fn consume(value: i32) {}
-- want/lib.rs --
fn run() {
    let total = 10;
    consume(1 + 2);
}

fn consume(value: i32) {}
