# Outline one trusted Java source file through the JDT LS backend.
exec cp src/Widget.java expected.java
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled
exec semedit outline --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --path src/Widget.java --include-unexported
stdout 'src/Widget\.java'
stdout 'Widget'
! stderr .+
exec cmp src/Widget.java expected.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
class Widget{}
