# Refuse to redirect a same-underlying field selection on a different named type.
env GOCACHE=$WORK/user-cache/build
env GOMODCACHE=$WORK/user-cache/mod
exec cp owner.go before-owner.txt
! exec semedit refactor-encapsulate-field --file owner.go --symbol owner.value --getter getValue --setter setValue
stderr 'different named receiver type'
cmp owner.go before-owner.txt
exec go test ./...

-- go.mod --
module example.com/encapsulatefieldderived

go 1.24
-- owner.go --
package sample

type owner struct {
	value int
}

type other owner

func (o *other) getValue() int { return 99 }
func (o *other) setValue(int) {}

func readOwner(o *owner) int { return o.value }
func readOther(o *other) int { return o.value }
