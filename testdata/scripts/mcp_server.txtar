stdout '"name":\s*"semantic_inspect_construct"'
stdout '"name":\s*"semantic_stage"'
stdout '"name":\s*"semantic_stage_drop"'
stdout '"name":\s*"semantic_stage_abort"'
stdout '"name":\s*"semantic_commit"'
stdout '"name":\s*"semantic_outline"'
stdout '"name":\s*"semantic_find_references"'
stdout '"name":\s*"semantic_add_build_dependency"'
stdout '"name":\s*"semantic_assertion_mode"'
