# Test MCP initialize and tools/list over stdio
stdin input.json
exec semedit mcp --live-reload
stdout '"name":\s*"semedit"'
stdout '"name":\s*"semantic_rename"'
stdout '"name":\s*"semantic_verify"'
stdout '"name":\s*"semantic_lookup"'
stdout '"name":\s*"semantic_add_build_dependency"'
stdout '"name":\s*"semantic_assertion_mode"'
stdout '"name":\s*"semantic_insert_case"'
stdout '"name":\s*"semantic_insert_decl"'
stdout '"name":\s*"semantic_insert_declaration"'
stdout '"name":\s*"semantic_insert_function"'
stdout '"name":\s*"semantic_insert_type"'
stdout '"name":\s*"semantic_maven_compile"'
stdout '"name":\s*"semantic_maven_test"'
stdout '"name":\s*"semantic_organize_imports"'
stdout '"name":\s*"semantic_replace_body"'
stdout '"name":\s*"semantic_replace_decl"'
stdout '"name":\s*"semantic_replace_construct"'
stdout '"name":\s*"semantic_scaffold_file"'
stdout '"name":\s*"semantic_snapshot"'
stdout '"name":\s*"semantic_undo"'
stdout '"name":\s*"semantic_batch"'
stdout '"name":\s*"semantic_reload"'

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}

-- main.go --
package main

-- src/main/java/App.java --
class App {}
