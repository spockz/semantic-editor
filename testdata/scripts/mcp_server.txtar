# tools/list via `exec semedit mcp --tool-profile full --live-reload --enable-batching` asserts `stdout '"name":\s*"refactor_encapsulate_field"'`, `stdout '"name":\s*"refactor_make_type_explicit"'`, `stdout '"name":\s*"refactor_promote_local_to_const"'`, `stdout '"name":\s*"semantic_search_adrs"'`, `stdout '"name":\s*"semantic_generate_adr_index"'`, `stdout '"name":\s*"semantic_batch"'`, and `stdout '"name":\s*"semantic_reload"'`.
stdin input.json
exec semedit mcp --tool-profile full --live-reload --enable-batching
stdout '"name":\s*"semedit"'
stdout '"name":\s*"refactor_rename"'
stdout '"name":\s*"refactor_make_static"'
stdout '"name":\s*"refactor_encapsulate_field"'
stdout '"name":\s*"refactor_make_type_explicit"'
