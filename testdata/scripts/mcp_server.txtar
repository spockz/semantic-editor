stdout '"name":\s*"refactor_move_file"'
stdout '"name":\s*"refactor_extract_callable"'
stdout '"name":\s*"refactor_extract_value"'
stdout '"name":\s*"refactor_inline_value"'
stdout '"name":\s*"refactor_extract_interface"'
stdout '"name":\s*"refactor_implement_contract"'
stdout '"name":\s*"refactor_extract_type"'
stdout '"name":\s*"refactor_extract_delegate"'
stdout '"name":\s*"refactor_migrate_type"'
stdout '"name":\s*"refactor_introduce_parameter"'
stdout '"name":\s*"refactor_introduce_parameter_object"'
stdout '"name":\s*"semantic_scaffold_file"'
stdout '"name":\s*"semantic_snapshot"'
