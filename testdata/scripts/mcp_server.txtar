# Test MCP initialize and tools/list over stdio
stdin input.json
exec semedit mcp
stdout '"name":\s*"semedit"'
stdout '"name":\s*"semantic_rename"'
stdout '"name":\s*"semantic_verify"'
stdout '"name":\s*"semantic_lookup"'

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05"}}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}
