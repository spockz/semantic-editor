-- src/Service.java --
class Service {
  int total = 1;
  int count() { return total; }
  int parameter(int total) { return total; }
  int explicit() { int total = 1; return total; }
  int duplicate() { { var total = 1; } { var total = 2; } return 0; }
  int loop() { for (var total = 0; total < 2; total++) {} return 0; }
  int lambda() { Runnable run = () -> { var total = 1; }; return 0; }
  int modified() { final var total = 1; return total; }
  Runnable anonymous() { var action = new Runnable() { public void run() {} }; return action; }
}
-- original.java --
class Service {
  int total = 1;
  int count() { return total; }
  int parameter(int total) { return total; }
  int explicit() { int total = 1; return total; }
  int duplicate() { { var total = 1; } { var total = 2; } return 0; }
  int loop() { for (var total = 0; total < 2; total++) {} return 0; }
  int lambda() { Runnable run = () -> { var total = 1; }; return 0; }
  int modified() { final var total = 1; return total; }
  Runnable anonymous() { var action = new Runnable() { public void run() {} }; return action; }
}
