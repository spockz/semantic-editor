-- repeated.go --
package render

var repeatedLeft, repeatedRight int

func PrintRepeated(left, right int) {
	repeatedLeft, repeatedRight = left, right
}

func RenderRepeated(count int) {
	PrintRepeated(count, count)
}

-- repeated_test.go --
package render

import "testing"

func TestRepeatedArguments(t *testing.T) {
	RenderRepeated(7)
	if repeatedLeft != 7 || repeatedRight != 7 {
		t.Fatalf("arguments = %d, %d", repeatedLeft, repeatedRight)
	}
}

-- want/repeated.go --
package render

var repeatedLeft, repeatedRight int

func PrintRepeated(left, right int) {
	repeatedLeft, repeatedRight = left, right
}

func RenderRepeated(count int) {
	selected := count
	PrintRepeated(selected, selected)
}
