# Verify formats real workspace Go sources while preserving invalid scratch, vendor, and module cache files.
exec semedit verify --path .
stdout 'Verification clean: 0 diagnostics'
cmp main.go want/main.go
cmp .scratch/go/mod/example.com/cache/cache.go want/.scratch/go/mod/example.com/cache/cache.go
cmp vendor/example.com/invalid/invalid.go want/vendor/example.com/invalid/invalid.go
-- go.mod --
module example.com/verify

go 1.23
-- main.go --
package   main

func   main(  )   {}
-- want/main.go --
package main

func main() {}
-- .scratch/go/mod/example.com/cache/cache.go --
package invalid {
-- want/.scratch/go/mod/example.com/cache/cache.go --
package invalid {
-- vendor/example.com/invalid/invalid.go --
package invalid {
-- want/vendor/example.com/invalid/invalid.go --
package invalid {
