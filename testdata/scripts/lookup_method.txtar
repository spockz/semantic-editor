# Lookup a method symbol by receiver and name
exec semedit lookup --file api/server.go --symbol "Server.Start"
stdout 'api/server\.go:[0-9]+'
stdout 'symbol: Server\.Start'

-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct{}

func (s *Server) Start() {}
