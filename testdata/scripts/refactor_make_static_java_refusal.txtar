# A disabled native Make Static action is refused without changing source.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_MAKE_STATIC=1 SEMEDIT_TEST_JAVA_MAKE_STATIC_REFUSAL=1 SEMEDIT_JAVA_ORGANIZE=1
! exec semedit refactor-make-static --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Service.java --symbol 'Service.count()'
stderr 'only disabled actions titled "Make Static"'
cmp src/Service.java want/Service.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Service.java --
package sample;
class Service {
  int count() { return 1; }
}

-- want/Service.java --
package sample;
class Service {
  int count() { return 1; }
}

