env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=1
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol total --in-function run --discriminator '1_i32 + 2_i32'
stderr 'unresolved imported or macro-expanded names'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "extract-variable-rust-spaced-include-fixture"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
    include /* comment */ !("later.rs");
}

fn consume(value: i32) {}
-- later.rs --
consume(total());
-- want/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
    include /* comment */ !("later.rs");
}

fn consume(value: i32) {}
