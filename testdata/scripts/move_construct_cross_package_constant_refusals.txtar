import "example.com/constantrefusals/types"

const IotaValue = iota
type RetryDuration int
const Named RetryDuration = 2
const ImportedType types.Count = 8
const Base = 3
const Dependent = Base
const ( Grouped = 4 )
const First, Second = 5, 5
const TestReferenced = 6
-- api/limits.go --
