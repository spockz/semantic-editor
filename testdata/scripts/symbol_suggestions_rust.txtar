# Rust lookup recovery uses selected-file rust-analyzer outline and exact retry.
env SEMEDIT_SUGGESTIONS=generic
! exec semedit lookup --language rust --trust-workspace --file src/lib.rs --symbol Widgte
stderr 'Suggested target: Widget \(src/lib.rs:1\)'
exec semedit lookup --language rust --trust-workspace --file src/lib.rs --symbol Widget
stdout 'src/lib.rs:1  struct Widget'

-- Cargo.toml --
[package]
name = "example"
version = "0.1.0"

-- src/lib.rs --
struct Widget {}
