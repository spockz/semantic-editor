# tools/list via `exec semedit mcp --tool-profile full --live-reload --enable-batching` asserts `stdout '"name":\s*"semantic_workspace_outline"'`, `stdout '"name":\s*"refactor_change_signature"'`, `stdout '"name":\s*"refactor_extract_callable"'`, `stdout '"name":\s*"refactor_encapsulate_field"'`, `stdout '"name":\s*"semantic_set_doc_comment"'`, `stdout '"name":\s*"semantic_search_adrs"'`, and `stdout '"name":\s*"semantic_generate_adr_index"'`.
stdin input.json
exec semedit mcp --tool-profile full --live-reload --enable-batching --profile full --enabled-languages go
stdout '"name":\s*"semantic_workspace_outline"'
stdout '"name":\s*"refactor_change_signature"'
stdout '"name":\s*"refactor_extract_callable"'
stdout '"name":\s*"refactor_encapsulate_field"'
stdout '"name":\s*"semantic_set_doc_comment"'
stdout '"name":\s*"semantic_search_adrs"'
stdout '"name":\s*"semantic_generate_adr_index"'

