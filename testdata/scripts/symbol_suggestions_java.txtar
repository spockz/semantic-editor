# Java lookup typo is enriched from the selected-file JDT LS outline and succeeds on explicit retry.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_SUGGESTIONS=generic
! exec semedit inspect-symbol --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widgte
stderr 'Suggested target: Widget \(src/Widget.java:1\)'
exec semedit inspect-symbol --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget
stdout '"qualified_name":\s*"Widget"'

! exec semedit lookup --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widgte
stderr 'Suggested target: Widget \(src/Widget.java:1\)'
exec semedit lookup --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget
stdout 'src/Widget.java:1  class Widget'

env SEMEDIT_JAVA_REFERENCE_URI=file://$WORK/src/Widget.java SEMEDIT_JAVA_REFERENCE_LINE=0 SEMEDIT_JAVA_REFERENCE_START=6 SEMEDIT_JAVA_REFERENCE_END=12
! exec semedit find-references --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widgte
stderr 'Suggested target: Widget \(src/Widget.java:1\)'
exec semedit find-references --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget
stdout 'References to Widget'

! exec semedit refactor-rename --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widgte --to Gadget
stderr 'Suggested target: Widget \(src/Widget.java:1\)'
exec semedit refactor-rename --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget --to Gadget
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder

-- tools/jdtls/config_win/.keep --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
class Widget {}
-- want/Widget.java --
class Gadget {}
