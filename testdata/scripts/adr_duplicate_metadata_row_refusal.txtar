# Search and index generation reject an appended duplicate metadata row without altering the register.
! exec semedit search-adrs --query schema
stderr 'metadata table has unexpected or duplicate rows after "languages"'
! exec semedit generate-adr-index
stderr 'metadata table has unexpected or duplicate rows after "languages"'
cmp docs/adr/README.md original-README.md

