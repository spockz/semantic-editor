-- want/parameter.go --
package sample

func AssignParameter(enabled bool, count int) int {
	switch enabled {
	case true:
		count = updateParameter(count)
	}
	return count
}

func updateParameter(count int) int {
	count = count + 1
	return count
}
-- parameter_test.go --
package sample

import "testing"

func TestAssignParameterSwitchCaseExtraction(t *testing.T) {
	if got := AssignParameter(true, 4); got != 5 {
		t.Fatalf("AssignParameter(true, 4) = %d, want 5", got)
	}
	if got := AssignParameter(false, 4); got != 4 {
		t.Fatalf("AssignParameter(false, 4) = %d, want 4", got)
	}
}
