# Extract a direct-call range from one expression-switch case body.
exec semedit inspect-construct --file service.go --in-function Emit --kind statement/expression --discriminator 'record(value)'
stdout '"construct_path": "0.0.0"'
stdout '"expected_revision": "dbaffae77bcadb98dd638b6b396d2250451014793047654a7babeab8531ffa9b"'
exec semedit refactor-extract-callable --file service.go --symbol recordPair --in-function Emit --kind function --construct-path 0.0.0 --end-construct-path 0.0.1 --expected-revision dbaffae77bcadb98dd638b6b396d2250451014793047654a7babeab8531ffa9b
cmp service.go want/service.go
! exec semedit refactor-extract-callable --file cross.go --symbol crossPair --in-function Cross --kind function --construct-path 0.0.0 --end-construct-path 0.1.0 --expected-revision 8d6aac2cf1346f8de41c3d7e3f714251bea49dc21febbb8f79fdc46ef864808b
stderr 'must select statements from the same block'
cmp cross.go original/cross.go
