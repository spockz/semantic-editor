-- loop.go --
package sample

func AssignInLoop(limit int) int {
	count, iterations := 0, 0
	for iterations < 5 && count < limit {
		iterations++
		switch true {
		case true:
			count = 1
		default:
			break
		}
	}
	return iterations
}
-- want/loop.go --
package sample

func AssignInLoop(limit int) int {
	count, iterations := 0, 0
	for iterations < 5 && count < limit {
		iterations++
		switch true {
		case true:
			count = updateLoopCount()
		default:
			break
		}
	}
	return iterations
}

func updateLoopCount() int {
	var count int
	count = 1
	return count
}
-- loop_test.go --
package sample

import "testing"

func TestAssignInLoopSwitchCaseExtraction(t *testing.T) {
	if got := AssignInLoop(1); got != 1 {
		t.Fatalf("AssignInLoop(1) = %d, want 1", got)
	}
	if got := AssignInLoop(3); got != 5 {
		t.Fatalf("AssignInLoop(3) = %d, want 5", got)
	}
}
