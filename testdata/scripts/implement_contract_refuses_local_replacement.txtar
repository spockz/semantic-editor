# Contract reads cannot currently bind a mutable local replacement module's manifest and file membership into its read set.
! exec semedit refactor-implement-contract --file worker.go --symbol Worker --contract Runner --contract-file runner.go --receiver-kind pointer --body-policy panic_stub --destination-file worker.go
stderr 'contract edits do not support mutable local replacement module "example.com/local/token" outside the captured module'
cmp go.mod .scratch/want/go.mod
cmp worker.go .scratch/want/worker.go
cmp runner.go .scratch/want/runner.go
cmp tokenlib/go.mod .scratch/want/tokenlib/go.mod
cmp tokenlib/token.go .scratch/want/tokenlib/token.go

-- go.mod --
module example.com/project

go 1.24

require example.com/local/token v0.0.0

replace example.com/local/token => ./tokenlib
-- worker.go --
package app

type Worker struct{}
-- runner.go --
package app

import "example.com/local/token"

type Runner interface {
	Run(token.Token)
}
-- tokenlib/go.mod --
module example.com/local/token

go 1.24
-- tokenlib/token.go --
package token

type Token string
-- .scratch/want/go.mod --
module example.com/project

go 1.24

require example.com/local/token v0.0.0

replace example.com/local/token => ./tokenlib
-- .scratch/want/worker.go --
package app

type Worker struct{}
-- .scratch/want/runner.go --
package app

import "example.com/local/token"

type Runner interface {
	Run(token.Token)
}
-- .scratch/want/tokenlib/go.mod --
module example.com/local/token

go 1.24
-- .scratch/want/tokenlib/token.go --
package token

type Token string
