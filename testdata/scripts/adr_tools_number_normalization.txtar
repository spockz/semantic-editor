# Accept adr-tools' unpadded title number while preserving the stable padded ADR identifier and workspace-relative path.
exec semedit search-adrs --query generated --limit 5
stdout '"id": "ADR-0001"'
stdout '"path": "docs/adr/0001-template-output.md"'
exec semedit generate-adr-index
stdout '"status":"synced"'
grep 'ADR-0001.*Template Output.*Accepted.*2026-10-21' docs/adr/README.md

-- .adr-dir --
docs/adr

