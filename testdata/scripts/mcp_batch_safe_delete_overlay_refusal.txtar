# A safe-delete struct child must analyze references inserted into the current batch overlay and preserve prior child edits on refusal.
stdin input.json
exec semedit mcp --enable-batching --live-reload
stdout '"status":"error"'
stdout 'safe_delete found another Go identifier named'
cmp decls.go .scratch/want/decls.go
cmp added.go .scratch/want/added.go
-- go.mod --
module example.com/safedeleteoverlay

go 1.24
-- decls.go --
package sample

type obsoleteRecord struct{}
func keep() {}
-- added.go --
package sample
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_insert_function","params":{"file":"added.go","source":"func Use() { _ = obsoleteRecord{} }"}},{"tool":"semantic_remove_construct","params":{"file":"decls.go","kind":"type","symbol":"obsoleteRecord","safe_delete":true}}]}}}
-- .scratch/want/decls.go --
package sample

type obsoleteRecord struct{}
func keep() {}
-- .scratch/want/added.go --
package sample

func Use() { _ = obsoleteRecord{} }
