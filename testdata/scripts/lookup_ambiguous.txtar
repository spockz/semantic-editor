# Lookup an unqualified symbol with multiple candidates
exec semedit lookup --file api/server.go --symbol "Start"
stdout 'Ambiguous lookup for .*Start.*2 candidates\.'
stdout 'Server\.Start'
stdout 'Client\.Start'

-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct{}

func (s *Server) Start() {}

type Client struct{}

func (c *Client) Start() {}
