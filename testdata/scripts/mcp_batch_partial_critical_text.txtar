# A partially executed batch reports final failure and the successful/failed child records before diffs.
stdin input.json
exec semedit mcp --enable-batching
stdout 'Critical result \(JSON\):'
stdout '"status":"error"'
stdout '"tool":"semantic_replace_body"'
stdout 'expected_revision does not match captured source'
stdout 'Batch child results are intermediate and do not provide final continuation targets.'
cmp main.go .scratch/want/main.go
-- go.mod --
module example.com.revisionbatch

go 1.24
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_replace_body","params":{"file":"main.go","symbol":"Value","body":"return 2"}},{"tool":"semantic_replace_body","params":{"file":"main.go","symbol":"Value","expected_revision":"e3a2d4d2188eae4090fa38fc8e2b149945b6443947bd73476b383ee4460cb72c","body":"return 3"}}]}}}
-- main.go --
package sample

func Value() int {
	return 1
}
-- .scratch/want/main.go --
package sample

func Value() int {
	return 2
}
