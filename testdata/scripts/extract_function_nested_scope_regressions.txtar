stdout '"expected_revision": "0556e35db70d7d3ef34faae8960c9e92a337ca877f188080103c4c638763d278"'
exec semedit refactor-extract-callable --file mixed.go --symbol extractValues --in-function RunMixed --kind function --construct-path 1.0.0 --end-construct-path 1.0.1 --expected-revision 0556e35db70d7d3ef34faae8960c9e92a337ca877f188080103c4c638763d278
stdout 'symbol: extractValues'
