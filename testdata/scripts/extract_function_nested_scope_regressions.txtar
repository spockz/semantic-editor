-- want/result_type_shadow.go --
package sample

import "reflect"
import dep "example.com/extractscope/dep"

type Result interface{}
type Box[T any] interface{}

func makeResult() Result   { return 1 }
func makeBox() Box[Result] { return 1 }

func isPackageResult[T any](value T) bool {
	return reflect.TypeOf((*T)(nil)).Elem() == reflect.TypeOf((*Result)(nil)).Elem()
}

func isPackageBox[T any](value T) bool {
	return reflect.TypeOf((*T)(nil)).Elem() == reflect.TypeOf((*Box[Result])(nil)).Elem()
}

func RunShadowedResult() bool {
	type Result interface{}
	count := 0
	if true {
		count = 1
		added := makeResult()
		println(count)
		return isPackageResult(added) && count == 1
	}
	return false
}

func RunShadowedGenericResult() bool {
	type Result interface{}
	count := 0
	if true {
		count = 1
		added := makeBox()
		println(count)
		return isPackageBox(added) && count == 1
	}
	return false
}

func RunImportedAlias() int {
	count := 0
	if true {
		var added dep.Result
		count, added = extractAlias()
		if added == 1 {
			return count
		}
	}
	return count
}

func extractAlias() (int, dep.Result) {
	var count int
	count = 1
	added := dep.New()
	println(count)
	return count, added
}

func makeError() error { return nil }

func RunErrorOutput() int {
	count := 0
	if true {
		var added error
		count, added = extractError()
		println(count, added)
	}
	return count
}

func extractError() (int, error) {
	var count int
	count = 1
	added := makeError()
	return count, added
}

func makeAny() any { return 1 }

func RunAnyOutput() int {
	count := 0
	if true {
		var added any
		count, added = extractAny()
		println(count, added)
	}
	return count
}

func extractAny() (int, any) {
	var count int
	count = 1
	added := makeAny()
	return count, added
}
