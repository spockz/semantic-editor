-- go.mod --
module example.com/extractscope

go 1.24
-- function.go --
package sample

func expected() { println(1) }
func unexpected() { println(2) }

func RunFunctionShadow(enabled bool) {
	if enabled {
		helper := unexpected
		_ = helper
		expected()
	}
}
