package sample

func RunMixed(enabled bool) int {
	count := 0
	if enabled {
		count = 1
		added := 2
		println(count, added)
	}
	return count
}
-- want/mixed.go --
package sample

func RunMixed(enabled bool) int {
	count := 0
	if enabled {
		var added int
		count, added = extractValues()
		println(count, added)
	}
	return count
}

func extractValues() (int, int) {
	var count int
	count = 1
	added := 2
	return count, added
}
-- liveout.go --
package sample

func RunLiveOut() {
	if true {
		value := 0
		value = 1
		println(value)
	}
}
-- want/liveout.go --
package sample

func RunLiveOut() {
	if true {
		value := 0
		updateValue()
		_ = value
	}
}

func updateValue() {
	var value int
	value = 1
	println(value)
}
-- regression_test.go --
package sample

import "testing"

func TestRunPreservesAncestorBinding(t *testing.T) {
	if got := RunMixed(true); got != 1 {
		t.Fatalf("RunMixed(true) = %d, want 1", got)
	}
	if got := RunMixed(false); got != 0 {
		t.Fatalf("RunMixed(false) = %d, want 0", got)
	}
}

func TestRunShadowedResultKeepsPackageTypeIdentity(t *testing.T) {
	if !RunShadowedResult() {
		t.Fatal("RunShadowedResult() = false, want true")
	}
}

func TestRunShadowedGenericResultKeepsPackageTypeIdentity(t *testing.T) {
	if !RunShadowedGenericResult() {
		t.Fatal("RunShadowedGenericResult() = false, want true")
	}
}

func TestRunErrorOutput(t *testing.T) {
	if got := RunErrorOutput(); got != 1 {
		t.Fatalf("RunErrorOutput() = %d, want 1", got)
	}
}

func TestRunAnyOutput(t *testing.T) {
	if got := RunAnyOutput(); got != 1 {
		t.Fatalf("RunAnyOutput() = %d, want 1", got)
	}
}

-- result_type_shadow.go --
package sample

import "reflect"
import dep "example.com/extractscope/dep"

type Result interface{}
type Box[T any] interface{}

func makeResult() Result { return 1 }
func makeBox() Box[Result] { return 1 }

func isPackageResult[T any](value T) bool {
	return reflect.TypeOf((*T)(nil)).Elem() == reflect.TypeOf((*Result)(nil)).Elem()
}

func isPackageBox[T any](value T) bool {
	return reflect.TypeOf((*T)(nil)).Elem() == reflect.TypeOf((*Box[Result])(nil)).Elem()
}

func RunShadowedResult() bool {
	type Result interface{}
	count := 0
	if true {
		count = 1
		added := makeResult()
		println(count)
		return isPackageResult(added) && count == 1
	}
	return false
}

func RunShadowedGenericResult() bool {
	type Result interface{}
	count := 0
	if true {
		count = 1
		added := makeBox()
		println(count)
		return isPackageBox(added) && count == 1
	}
	return false
}

func RunImportedAlias() int {
	count := 0
	if true {
		count = 1
		added := dep.New()
		println(count)
		if added == 1 {
			return count
		}
	}
	return count
}

func makeError() error { return nil }

func RunErrorOutput() int {
	count := 0
	if true {
		count = 1
		added := makeError()
		println(count, added)
	}
	return count
}

func makeAny() any { return 1 }

func RunAnyOutput() int {
	count := 0
	if true {
		count = 1
		added := makeAny()
		println(count, added)
	}
	return count
}
