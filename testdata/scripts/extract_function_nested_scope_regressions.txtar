# WHY: Keep public CLI coverage for nested generated-call binding, mixed live-outs, and reads inside the selected region.
exec semedit inspect-construct --file function.go --in-function RunFunctionShadow --kind statement/expression --discriminator expected()
stdout '"construct_path": "0.0.2"'
stdout '"expected_revision": "0d4eda6589f3f0ce82d3c4f6f43abab8f5a3bca374ad2ba245447e9e362e886d"'
! exec semedit refactor-extract-callable --file function.go --symbol helper --in-function RunFunctionShadow --kind function --construct-path 0.0.2 --end-construct-path 0.0.2 --expected-revision 0d4eda6589f3f0ce82d3c4f6f43abab8f5a3bca374ad2ba245447e9e362e886d
stderr 'generated call binding for "helper" is shadowed at the replacement site'
cmp function.go original/function.go

exec semedit inspect-construct --file method.go --in-function '(*T).RunMethodShadow' --kind statement/expression --discriminator println(1)
stdout '"construct_path": "0.0.2"'
stdout '"expected_revision": "636272caa5809056d906525d5265dfb36d23d748b534ebbb929312c52345c75d"'
! exec semedit refactor-extract-callable --file method.go --symbol helper --in-function '(*T).RunMethodShadow' --kind method --construct-path 0.0.2 --end-construct-path 0.0.2 --expected-revision 636272caa5809056d906525d5265dfb36d23d748b534ebbb929312c52345c75d
stderr 'generated call binding for "helper" is shadowed at the replacement site'
cmp method.go original/method.go

