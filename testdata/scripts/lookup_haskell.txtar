# Lookup through the standalone Haskell CLI backend and its explicitly configured toolchain.
exec semedit lookup --language haskell --haskell-standalone --trust-workspace --ghc-bin $SEMEDIT_TEST_GHC --hls-bin $SEMEDIT_TEST_HLS --ghc-version 9.8.2 --hls-version 2.9.0 --file src/Widget.hs --symbol Widget
stdout '"file":\s*"src/Widget.hs"'
stdout '"symbol":\s*"Widget"'

-- src/Widget.hs --
data Widget = Widget
