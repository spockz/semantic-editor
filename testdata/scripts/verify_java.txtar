# Verify a trusted Java selected file through the central CLI operation registry.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled
# Check-only suppresses both mutation flags.
cp src/Widget.java original.txt
exec semedit verify --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --format-selected-file --organize-imports --check-only
cmp src/Widget.java original.txt

env SEMEDIT_ASSERT_JAVA_VERIFY=1
exec semedit verify --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --format-selected-file --organize-imports
stdout 'Verification clean: 0 diagnostics'
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
class Widget {
}

-- want/Widget.java --
class Widget {}
