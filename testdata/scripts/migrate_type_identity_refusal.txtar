# A distinct named type with the same underlying type is not alias-identical and leaves the source unchanged.
! exec semedit refactor-migrate-type --file settings.go --symbol Settings.timeout --type Timeout
stderr 'not identical after alias resolution'
cmp settings.go .scratch/want/settings.go

-- go.mod --
module example.com/migraterefusal

go 1.24
-- settings.go --
package sample

type Timeout int64
type Duration int64

type Settings struct {
	timeout Duration
}
-- .scratch/want/settings.go --
package sample

type Timeout int64
type Duration int64

type Settings struct {
	timeout Duration
}
