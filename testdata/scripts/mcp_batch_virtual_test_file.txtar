# A public MCP batch renames a helper in a scaffolded virtual Go test file using an explicit file selector.
stdin input.json
exec semedit mcp
stdout '"isError":false'
cmp helper_test.go .scratch/want/helper_test.go
exec go test ./...
-- go.mod --
module example.com/virtualtestfile

go 1.24
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_scaffold_file","params":{"file":"helper_test.go","package":"sample"}},{"tool":"semantic_insert_function","params":{"file":"helper_test.go","source":"func helper() int { return 1 }"}},{"tool":"semantic_rename","params":{"file":"helper_test.go","symbol":"helper","to":"Helper"}}]}}}
-- .scratch/want/helper_test.go --
package sample

func Helper() int { return 1 }
