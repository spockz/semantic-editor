# Extract a complete direct map range and preserve named types, empty cases, map identity, and mutation visibility.
exec semedit refactor-extract-callable --file service.go --symbol visit --in-function Run --kind function --start-line 10 --end-line 12
stdout 'symbol: visit'
cmp service.go want/service.go
exec go test ./...

-- go.mod --
module example.com/extractrangemap

go 1.23
-- service.go --
package sample

type EntryMap map[int]string

var seen map[int]string
var alias EntryMap
var callbackCount int

func Run(entries EntryMap) {
	for key, value := range entries {
		record(key, value)
	}
}

func RunLocal() {
	entries := EntryMap{3: "three", 4: "four"}
	for key, value := range entries {
		record(key, value)
	}
}

func RunAndClear(entries EntryMap) {
	alias = entries
	callbackCount = 0
	for key, value := range entries {
		recordAndClear(key, value)
	}
}

func record(key int, value string) {
	seen[key] = value
}

func recordAndClear(key int, value string) {
	seen[key] = value
	if callbackCount == 0 {
		clear(alias)
	}
	callbackCount++
}
-- service_test.go --
package sample

import (
	"reflect"
	"testing"
)

func TestMapRangeExtractionPreservesNilEmptyAndEntries(t *testing.T) {
	seen = map[int]string{}
	Run(nil)
	Run(EntryMap{})
	if len(seen) != 0 {
		t.Fatalf("nil and empty maps produced entries: %v", seen)
	}

	want := map[int]string{1: "one", 2: "two", 3: "three"}
	Run(EntryMap{1: "one", 2: "two", 3: "three"})
	if !reflect.DeepEqual(seen, want) {
		t.Fatalf("Run entries = %v, want %v", seen, want)
	}
}

func TestMapRangeExtractionPreservesLocalMapAndAliasMutation(t *testing.T) {
	seen = map[int]string{}
	RunLocal()
	wantLocal := map[int]string{3: "three", 4: "four"}
	if !reflect.DeepEqual(seen, wantLocal) {
		t.Fatalf("RunLocal entries = %v, want %v", seen, wantLocal)
	}

	entries := EntryMap{1: "one", 2: "two", 3: "three"}
	seen = map[int]string{}
	RunAndClear(entries)
	if callbackCount != 1 || len(entries) != 0 || len(seen) != 1 {
		t.Fatalf("alias mutation: callbacks=%d entries=%v seen=%v", callbackCount, entries, seen)
	}
}
-- want/service.go --
package sample

type EntryMap map[int]string

var seen map[int]string
var alias EntryMap
var callbackCount int

func Run(entries EntryMap) {
	visit(entries)
}

func visit(entries EntryMap) {
	for key, value := range entries {
		record(key, value)
	}
}

func RunLocal() {
	entries := EntryMap{3: "three", 4: "four"}
	for key, value := range entries {
		record(key, value)
	}
}

func RunAndClear(entries EntryMap) {
	alias = entries
	callbackCount = 0
	for key, value := range entries {
		recordAndClear(key, value)
	}
}

func record(key int, value string) {
	seen[key] = value
}

func recordAndClear(key int, value string) {
	seen[key] = value
	if callbackCount == 0 {
		clear(alias)
	}
	callbackCount++
}
