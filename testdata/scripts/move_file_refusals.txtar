# Refused file moves preserve both the source and destination files.
! exec semedit move-file --file tagged/foo.go --destination-file destinations/tagged/moved.go
stderr 'cross-package move refuses generated or build-constrained'
cmp tagged/foo.go .scratch/_want/tagged/foo.go
cmp destinations/tagged/moved.go .scratch/_want/destinations/tagged/moved.go
! exec semedit move-file --file generated/foo.go --destination-file destinations/generated/moved.go
stderr 'cross-package move refuses generated or build-constrained'
cmp generated/foo.go .scratch/_want/generated/foo.go
cmp destinations/generated/moved.go .scratch/_want/destinations/generated/moved.go
! exec semedit move-file --file generatedcaller/foo.go --destination-file destinations/generatedcaller/moved.go
stderr 'generated or build-constrained file.*generated_caller.go'
cmp generatedcaller/foo.go .scratch/_want/generatedcaller/foo.go
cmp generatedcaller/generated_caller.go .scratch/_want/generatedcaller/generated_caller.go
cmp destinations/generatedcaller/moved.go .scratch/_want/destinations/generatedcaller/moved.go
! exec semedit move-file --file shared/foo.go --destination-file destinations/shared/moved.go
stderr 'refuses matching tests that depend on test helper sharedHelper.*helper_test.go'
cmp shared/foo.go .scratch/_want/shared/foo.go
cmp shared/foo_test.go .scratch/_want/shared/foo_test.go
cmp shared/helper_test.go .scratch/_want/shared/helper_test.go
cmp destinations/shared/moved.go .scratch/_want/destinations/shared/moved.go
! exec semedit move-file --file testmain/foo.go --destination-file destinations/testmain/moved.go
stderr 'refuses TestMain in affected package.*main_test.go'
cmp testmain/foo.go .scratch/_want/testmain/foo.go
cmp testmain/foo_test.go .scratch/_want/testmain/foo_test.go
cmp testmain/main_test.go .scratch/_want/testmain/main_test.go
cmp destinations/testmain/moved.go .scratch/_want/destinations/testmain/moved.go
! exec semedit move-file --file collision/foo.go --destination-file destinations/testcollision/moved.go
stderr 'matching test destination already exists'
cmp collision/foo.go .scratch/_want/collision/foo.go
cmp collision/foo_test.go .scratch/_want/collision/foo_test.go
cmp destinations/testcollision/moved.go .scratch/_want/destinations/testcollision/moved.go
cmp destinations/testcollision/moved_test.go .scratch/_want/destinations/testcollision/moved_test.go
! exec semedit move-file --file symbolcollision/foo.go --destination-file destinations/symbolcollision/moved.go
stderr 'Move redeclared in this block'
cmp symbolcollision/foo.go .scratch/_want/symbolcollision/foo.go
cmp destinations/symbolcollision/moved.go .scratch/_want/destinations/symbolcollision/moved.go
cmp destinations/symbolcollision/other.go .scratch/_want/destinations/symbolcollision/other.go
! exec semedit move-file --file private/foo.go --destination-file destinations/private/moved.go
stderr 'source-package dependency'
cmp private/foo.go .scratch/_want/private/foo.go
cmp private/remaining.go .scratch/_want/private/remaining.go
cmp destinations/private/moved.go .scratch/_want/destinations/private/moved.go
! exec semedit move-file --file embedded/foo.go --destination-file destinations/embedded/moved.go
stderr 'move_file refuses package variables'
cmp embedded/foo.go .scratch/_want/embedded/foo.go
cmp embedded/payload.txt .scratch/_want/embedded/payload.txt
cmp destinations/embedded/moved.go .scratch/_want/destinations/embedded/moved.go
! exec semedit move-file --file relative/foo.go --destination-file destinations/relative/moved.go
stderr 'relative fixture path'
cmp relative/foo.go .scratch/_want/relative/foo.go
cmp relative/foo_test.go .scratch/_want/relative/foo_test.go
cmp destinations/relative/moved.go .scratch/_want/destinations/relative/moved.go
! exec semedit move-file --file cycleold/foo.go --destination-file cycleapi/moved.go
stderr 'import cycle not allowed'
cmp cycleold/foo.go .scratch/_want/cycleold/foo.go
cmp cycleapi/moved.go .scratch/_want/cycleapi/moved.go
! exec semedit move-file --file dependency/foo.go --destination-file destinations/dependency/moved.go
stderr 'source-package dependency "Sibling at .*sibling.go" outside the moved declaration set'
cmp dependency/foo.go .scratch/_want/dependency/foo.go
cmp dependency/sibling.go .scratch/_want/dependency/sibling.go
cmp destinations/dependency/moved.go .scratch/_want/destinations/dependency/moved.go
! exec semedit move-file --file initialized/foo.go --destination-file destinations/initialized/moved.go
stderr 'initialization'
cmp initialized/foo.go .scratch/_want/initialized/foo.go
cmp effectpkg/effect.go .scratch/_want/effectpkg/effect.go
cmp destinations/initialized/moved.go .scratch/_want/destinations/initialized/moved.go
! exec semedit move-file --file packageinit/foo.go --destination-file destinations/packageinit/moved.go
stderr 'initialization'
cmp packageinit/foo.go .scratch/_want/packageinit/foo.go
cmp destinations/packageinit/moved.go .scratch/_want/destinations/packageinit/moved.go

