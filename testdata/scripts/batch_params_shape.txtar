# Reject misspelled batch arguments and report missing required parameters before workspace operations.
stdin input.json
exec semedit mcp --enable-batching
stdout 'isError":true'
stdout 'edit 0 params'
stdout 'refactor_rename'
stdout 'unknown parameter'
stdout 'symobl'
stdout 'Required parameters'
grep 'func Old' file.go
! grep 'func New' file.go

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"edits":[{"tool":"refactor_rename","symobl":"Old","to":"New"}]}}}

-- go.mod --
module example.com/batchparams

go 1.23

-- file.go --
package batchparams

func Old() {}
