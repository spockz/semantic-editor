# Reject duplicate ADR identifiers before search or generated-index publication.
! exec semedit search-adrs --query duplicate
stderr 'duplicate ADR ID 0001'
! exec semedit generate-adr-index
stderr 'duplicate ADR ID 0001'
cmp docs/adr/README.md original-README.md

