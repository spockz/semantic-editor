# Lookup through the Java CLI backend and an explicitly configured JDT LS home.
env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled
exec semedit lookup --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol Widget
stdout 'src/Widget\.java:[0-9]+.*Widget'

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_linux/.keep --
placeholder
-- tools/jdtls/config_win/.keep --
placeholder
-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
class Widget {}
