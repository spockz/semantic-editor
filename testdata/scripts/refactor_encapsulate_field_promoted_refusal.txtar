# Refuse a field selection promoted through an embedded owner before changing any source.
env GOCACHE=$WORK/user-cache/build
env GOMODCACHE=$WORK/user-cache/mod
exec cp owner.go before-owner.txt
! exec semedit refactor-encapsulate-field --file owner.go --symbol owner.value --getter getValue --setter setValue
stderr 'refuses an owner embedded elsewhere in its package'
cmp owner.go before-owner.txt
exec go test

-- go.mod --
module example.com/encapsulatefieldpromoted

go 1.24
-- owner.go --
package sample

type owner struct { value int }

type wrapper struct { owner }

func readPromoted(value wrapper) int { return value.value }
