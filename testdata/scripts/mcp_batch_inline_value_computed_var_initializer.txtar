# Verify a buffered body replacement feeds computed-value inlining into an immediate local var initializer.
stdin input.json
exec semedit mcp
stdout '"isError":false'
stdout '"operation":"refactor_inline_value"'
stdout '"status":"applied_working"'
cmp calc.go .scratch/want/calc.go
exec go test ./...

-- go.mod --
module example.com/batchinlinecomputedvar

go 1.23
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":false,"edits":[{"tool":"semantic_replace_body","params":{"file":"calc.go","symbol":"Build","body":"value := seed + 2\nvar result = value\nreturn result"}},{"tool":"refactor_inline_value","params":{"file":"calc.go","symbol":"value","in_function":"Build"}}]}}}
-- calc.go --
package calc

func Build(seed int) int {
	return seed
}
-- .scratch/want/calc.go --
package calc

func Build(seed int) int {
	var result = seed + 2
	return result
}
-- calc_test.go --
package calc

import "testing"

func TestBuild(t *testing.T) {
	if got := Build(5); got != 7 {
		t.Errorf("Build(5) = %d, want 7", got)
	}
}
