# Preserve declared and effectful result types when extracting multiple outputs.
exec semedit refactor-extract-callable --file distance.go --symbol describeDistance --in-function EmitDistance --kind function --start-line 6 --end-line 6
stdout 'symbol: describeDistance'
cmp distance.go want/distance.go
exec semedit refactor-extract-callable --file effectful.go --symbol describeResult --in-function EmitEffectful --kind function --start-line 4 --end-line 4
stdout 'symbol: describeResult'
cmp effectful.go want/effectful.go
exec go test ./...

-- go.mod --
module example.com/extractfunctiontypes

go 1.23
-- distance.go --
package distance

type Distance int

func EmitDistance(distance Distance) {
	value, unit := distance, "m"
	println(value, unit)
}

func readDistance() Distance { return 1 }
-- want/distance.go --
package distance

type Distance int

func EmitDistance(distance Distance) {
	value, unit := describeDistance(distance)
	println(value, unit)
}

func describeDistance(distance Distance) (Distance, string) {
	value, unit := distance, "m"
	return value, unit
}

func readDistance() Distance { return 1 }
-- effectful.go --
package distance

func EmitEffectful() {
	value, unit := readDistance(), "m"
	println(value, unit)
}
-- want/effectful.go --
package distance

func EmitEffectful() {
	value, unit := describeResult()
	println(value, unit)
}

func describeResult() (Distance, string) {
	value, unit := readDistance(), "m"
	return value, unit
}
