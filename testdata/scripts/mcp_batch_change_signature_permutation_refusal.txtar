# A rejected permutation retains earlier successful batch work without changing the target signature.
mkdir .scratch
cp service.go .scratch/service.txt
cp calls.go .scratch/calls.txt
stdin input.json
exec semedit mcp
stdout '"isError":true'
stdout 'compiler-proven constant'
cmp service.go .scratch/service.txt
cmp calls.go .scratch/want/calls.txt
-- go.mod --
module example.com/permutationbatchrefusal

go 1.24
-- service.go --
package sample

func combine(left, right int) int { return left*100 + right }
-- calls.go --
package sample

func first() int { return combine(1, 2) }
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","initializationOptions":{"trust_workspace":true}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"semantic_batch","arguments":{"auto_organize_imports":true,"edits":[{"tool":"semantic_replace_body","params":{"file":"calls.go","symbol":"first","body":"value := 7; return combine(value, 2)"}},{"tool":"refactor_change_signature","params":{"file":"service.go","symbol":"combine","parameters":[{"source_index":1,"parameter":{"name":"right","type":"int"}},{"source_index":0,"parameter":{"name":"left","type":"int"}}]}}]}}}
-- .scratch/want/calls.txt --
package sample

func first() int {
	value := 7
	return combine(value, 2)
}
