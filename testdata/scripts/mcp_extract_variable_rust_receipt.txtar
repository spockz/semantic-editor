# Rust extraction returns a revision-guarded owner continuation after the rust-analyzer assist.
env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=1
stdin input.json
exec semedit mcp
stdout '"isError":false'
stdout '"operation":"refactor_extract_value"'
stdout '"continuations":'
stdout '"file":"src/lib.rs"'
stdout '"symbol":"run"'
stdout '"expected_revision":"[0-9a-f]{64}"'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "rust-extract-receipt"
version = "0.1.0"
edition = "2021"
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"refactor_extract_value","arguments":{"language":"rust","trust_workspace":true,"file":"src/lib.rs","symbol":"total","in_function":"run","discriminator":"1_i32 + 2_i32"}}}
-- src/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
-- want/lib.rs --
fn run() {
    let total = 1_i32 + 2_i32;
    consume(total);
}

fn consume(value: i32) {}
