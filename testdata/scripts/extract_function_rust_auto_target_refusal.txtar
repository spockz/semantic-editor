env SEMEDIT_TEST_RUST_EXTRACT_CALLABLE=1
exec cp src/lib.rs before-lib.txt
! exec semedit refactor-extract-callable --language rust --trust-workspace --file src/lib.rs --symbol extracted --in-function run --kind function --start-line 2 --end-line 2
stderr 'rust callable extraction currently requires a single-source Cargo package'
cmp src/lib.rs before-lib.txt

-- Cargo.toml --
[package]
name = "rust-auto-target-refusal"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
-- src/bin/vendor/Cargo.toml --
[package]
name = "rust-vendor-bin"
version = "0.1.0"
edition = "2021"
-- src/bin/vendor/main.rs --
include!("../../lib.rs");
fn extracted() {}
fn main() { run(); }
