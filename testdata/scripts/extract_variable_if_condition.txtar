# Extract a complete pure if condition at its existing evaluation point; refuse init clauses and effectful conditions.
exec semedit refactor-extract-value --file branch.go --symbol selected --in-function RenderBranch --kind variable --discriminator 'count > 0'
cmp branch.go want/branch.go
exec semedit refactor-extract-value --file nested.go --symbol selected --in-function RenderNested --kind variable --discriminator 'count < 10'
cmp nested.go want/nested.go
exec semedit refactor-extract-value --file local.go --symbol selected --in-function RenderLocal --kind variable --discriminator ready
cmp local.go want/local.go
! exec semedit refactor-extract-value --file shadow.go --symbol selected --in-function RenderShadow --kind variable --discriminator ready
stderr 'if condition must contain a resolved typed Go input'
cmp shadow.go original/shadow.go
! exec semedit refactor-extract-value --file init.go --symbol selected --in-function RenderInit --kind variable --discriminator 'limit > 0'
stderr 'if conditions with an init clause are not supported'
cmp init.go original/init.go
! exec semedit refactor-extract-value --file effect.go --symbol selected --in-function RenderEffect --kind variable --discriminator 'ready()'
stderr 'if condition must be side-effect-free'
cmp effect.go original/effect.go
exec go test ./...

-- go.mod --
module example.com/extractvariableifcondition

go 1.24
-- branch.go --
package render

func RenderBranch(count int) int {
	if count > 0 {
		return count
	}
	return 0
}
-- want/branch.go --
package render

func RenderBranch(count int) int {
	selected := count > 0
	if selected {
		return count
	}
	return 0
}
-- nested.go --
package render

func RenderNested(count int) int {
	if count >= 0 {
		if count < 10 {
			return count
		}
	}
	return 0
}
-- want/nested.go --
package render

func RenderNested(count int) int {
	if count >= 0 {
		selected := count < 10
		if selected {
			return count
		}
	}
	return 0
}
-- local.go --
package render

func RenderLocal() bool {
	ready := true
	if ready {
		return true
	}
	return false
}
-- want/local.go --
package render

func RenderLocal() bool {
	ready := true
	selected := ready
	if selected {
		return true
	}
	return false
}
-- shadow.go --
package render

func RenderShadow(ready bool) bool {
	{
		const ready = true
		if ready {
			return true
		}
	}
	return false
}
-- original/shadow.go --
package render

func RenderShadow(ready bool) bool {
	{
		const ready = true
		if ready {
			return true
		}
	}
	return false
}
-- init.go --
package render

func RenderInit(count int) int {
	if limit := count; limit > 0 {
		return limit
	}
	return 0
}
-- original/init.go --
package render

func RenderInit(count int) int {
	if limit := count; limit > 0 {
		return limit
	}
	return 0
}
-- effect.go --
package render

func ready() bool { return true }

func RenderEffect() int {
	if ready() {
		return 1
	}
	return 0
}
-- original/effect.go --
package render

func ready() bool { return true }

func RenderEffect() int {
	if ready() {
		return 1
	}
	return 0
}
-- render_test.go --
package render

import "testing"

func TestExtractIfConditionPreservesBranches(t *testing.T) {
	if got := RenderBranch(1); got != 1 {
		t.Fatalf("RenderBranch(1) = %d, want 1", got)
	}
	if got := RenderBranch(-1); got != 0 {
		t.Fatalf("RenderBranch(-1) = %d, want 0", got)
	}
	if got := RenderNested(5); got != 5 {
		t.Fatalf("RenderNested(5) = %d, want 5", got)
	}
	if got := RenderNested(12); got != 0 {
		t.Fatalf("RenderNested(12) = %d, want 0", got)
	}
}
