# Make outline keeps exact make-ls ranges and reports intentional partial projections.
exec semedit outline --language make --trust-workspace --make-bin $SEMEDIT_TEST_MAKE_LS --path Read.mk
stdout 'all'
stdout 'Read\.mk:1-3'
stdout '\(partial\)'
cmp Read.mk want.mk
exec semedit outline --language make --trust-workspace --make-bin $SEMEDIT_TEST_MAKE_LS --path Conditional.mk
stdout 'Conditional\.mk'
stdout '\(partial\)'
exec semedit outline --language make --trust-workspace --make-bin $SEMEDIT_TEST_MAKE_LS --path Include.mk
stdout 'Include\.mk'
stdout '\(partial\)'
! semedit outline --language make --trust-workspace --make-bin $SEMEDIT_TEST_MAKE_LS --path Continued.mk
stderr 'continued declaration'
! semedit inspect-symbol --language make --trust-workspace --make-bin $SEMEDIT_TEST_MAKE_LS --file Continued.mk --symbol FLAG
stderr 'continued declaration'

-- Read.mk --
all:
	@echo one
	@echo two
next:
	@echo next
-- want.mk --
all:
	@echo one
	@echo two
next:
	@echo next
-- Conditional.mk --
ifeq ($(MODE),1)
all:
	@echo yes
endif
-- Include.mk --
include external.mk
-- Continued.mk --
FLAGS := -Wall \
  -Wextra
