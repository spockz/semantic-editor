# Java full-catalog discovery advertises the distinct native type-expansion intent.
stdin input.json
exec semedit mcp --tool-profile full --live-reload --enabled-languages=java
stdout '"name":"refactor_make_type_explicit"'

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}
