# Aborting a queried working view restores disk declarations before the next rename.
stdin input.json
exec semedit mcp --tool-profile full
! stdout '"isError":true'
stdout '"status":"aborted"'
stdout '"remaining_count":0'
cmp value.go .scratch/want/value.go
! exists generated.go

-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"semantic_verify","arguments":{"check_only":true}}}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"semantic_stage","arguments":{}}}
{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"semantic_replace_body","arguments":{"file":"value.go","symbol":"Value","body":"return 2"}}}
{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"semantic_scaffold_file","arguments":{"file":"generated.go","package":"sample"}}}
{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"semantic_insert_function","arguments":{"file":"generated.go","source":"func Generated() int { return Value() }"}}}
{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"semantic_rename","arguments":{"file":"generated.go","symbol":"Generated","to":"Staged"}}}
{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"semantic_stage_abort","arguments":{}}}
{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"semantic_rename","arguments":{"file":"value.go","symbol":"Value","to":"Published"}}}
{"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"semantic_verify","arguments":{"check_only":true}}}
-- go.mod --
module example.com/stageabort

go 1.24
-- value.go --
package sample

func Value() int { return 1 }
-- .scratch/want/value.go --
package sample

func Published() int { return 1 }
