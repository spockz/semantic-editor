# Lookup through the Rust CLI backend and its configured language server.
exec semedit lookup --language rust --trust-workspace --file src/lib.rs --symbol Widget
stdout '"file":\s*"src/lib.rs"'
stdout '"symbol":\s*"Widget"'

-- Cargo.toml --
[package]
name = "example"
version = "0.1.0"

-- src/lib.rs --
struct Widget {}
