# Extract direct two-index slice-expression ranges with omitted and explicit bounds while preserving panic, iteration, and backing-array behavior.
exec semedit refactor-extract-callable --file all.go --symbol walkAll --in-function WalkAll --kind function --start-line 4 --end-line 6
cmp all.go want/all.go.txt
exec semedit refactor-extract-callable --file from.go --symbol walkFrom --in-function WalkFrom --kind function --start-line 4 --end-line 6
cmp from.go want/from.go.txt
exec semedit refactor-extract-callable --file to.go --symbol walkTo --in-function WalkTo --kind function --start-line 4 --end-line 6
cmp to.go want/to.go.txt
exec semedit refactor-extract-callable --file bounded.go --symbol walkBounded --in-function WalkBounded --kind function --start-line 4 --end-line 6
cmp bounded.go want/bounded.go.txt
