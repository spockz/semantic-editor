env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=native-shape
exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol total --in-function run --discriminator '1_i32 + 2_i32'
stdout 'Extracted the Rust expression with a rust-analyzer assist'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "extract-variable-native-shape-fixture"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
-- want/lib.rs --
fn run() {
    let total = 1_i32 + 2_i32;
    consume(total);
}

fn consume(value: i32) {}
