# Refuse sharing a value across calls when an escaped owner input can change during the first call.
! exec semedit refactor-extract-value --file render.go --symbol shared --in-function Render --kind variable --discriminator 'count + step' --construct-path 1 --end-construct-path 2 --expected-revision 88d218c25a6073c86448f51ed4678ebde2dfa176e191da50128d51d5ebd18d76
stderr 'an input read by the expression escapes through its address'
cmp render.go .scratch/original.go
exec go test ./...

-- go.mod --
module example.com/extractvariablerepeatedcallescape

go 1.24
-- render.go --
package render

var escaped *int
var observed []int

func leak(value *int) {
	escaped = value
}

func sink(value int) {
	observed = append(observed, value)
	if escaped != nil {
		(*escaped)++
	}
}

func Render(count, step int) {
	leak(&count)
	sink(count + step)
	sink(count + step)
}
-- .scratch/original.go --
package render

var escaped *int
var observed []int

func leak(value *int) {
	escaped = value
}

func sink(value int) {
	observed = append(observed, value)
	if escaped != nil {
		(*escaped)++
	}
}

func Render(count, step int) {
	leak(&count)
	sink(count + step)
	sink(count + step)
}
-- render_test.go --
package render

import (
	"reflect"
	"testing"
)

func TestRepeatedCallsObserveMutatedEscapedInput(t *testing.T) {
	Render(4, 1)
	if !reflect.DeepEqual(observed, []int{5, 6}) {
		t.Fatalf("observed values = %v", observed)
	}
}
