cmp record.go .scratch/cases/alias.txt
cp .scratch/cases/implicit.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
