stderr 'generated type "int" is shadowed'
cmp record.go .scratch/cases/valid.txt
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state --expected-revision stale
stderr 'expected_revision does not match'
cmp record.go .scratch/cases/valid.txt
cp .scratch/cases/use.txt use.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'referenced outside the selected file'
