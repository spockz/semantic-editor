cmp use.go .scratch/cases/use.txt

-- go.mod --
module example.com/extracttypekeyedrefusal

go 1.24
-- .scratch/cases/comment.txt --
package sample

type record struct {
	first int
	second int
}

var value = record{first: 1 /* retain */, second: 2}
-- .scratch/cases/shadow.txt --
package sample

type record struct {
	first int
	second int
}

func build() record {
	type recordState = struct {
		first int
		second int
	}
	return record{first: 1, second: 2}
}
-- .scratch/cases/overlap.txt --
package sample

type record struct {
	first int
	second int
}

var original record
var value = record{first: original.first, second: 2}
-- .scratch/cases/nested.txt --
package sample

type record struct {
	first *record
	second int
}

var value = record{first: &record{second: 2}}
-- .scratch/cases/directive.txt --
package sample

type record struct {
	first int
	second int
}

//line record.go:70
var value = record{first: 1, second: 2}
-- .scratch/cases/positional.txt --
package sample

type record struct {
	first int
	second int
}

var value = record{1, 2}
-- .scratch/cases/valid.txt --
package sample

type record struct {
	first int
	second int
}

var value = record{first: 1, second: 2}
-- .scratch/cases/alias.txt --
package sample

type record struct {
	first int
	second int
}

type alias = record
var value = alias{first: 1, second: 2}
-- .scratch/cases/implicit.txt --
package sample

type record struct {
	first int
	second int
}

var values = []record{{first: 1, second: 2}}
-- .scratch/cases/use.txt --
package sample

var secondValue = record{first: 3, second: 4}
