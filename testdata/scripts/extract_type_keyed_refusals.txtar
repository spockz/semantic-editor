# WHY: Unsupported keyed layouts, scope capture, comments, directives, and overlapping rewrites leave all input bytes intact.
cp .scratch/cases/comment.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'comments inside owner literals'
cmp record.go .scratch/cases/comment.txt
cp .scratch/cases/shadow.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'generated type "recordState" is shadowed'
cmp record.go .scratch/cases/shadow.txt
cp .scratch/cases/overlap.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'extraction edits overlap'
cmp record.go .scratch/cases/overlap.txt
cp .scratch/cases/nested.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'extraction edits overlap'
cmp record.go .scratch/cases/nested.txt
cp .scratch/cases/directive.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'source-line directives'
cmp record.go .scratch/cases/directive.txt
cp .scratch/cases/positional.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
stderr 'unkeyed record literals'
cmp record.go .scratch/cases/positional.txt
cp .scratch/cases/alias.txt record.go
! exec semedit refactor-extract-type --file record.go --symbol recordState --in-type record --members '[{"file":"record.go","symbol":"record.first"},{"file":"record.go","symbol":"record.second"}]' --field state
