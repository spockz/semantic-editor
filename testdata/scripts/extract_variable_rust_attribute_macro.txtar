env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=1
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol total --in-function run --discriminator '1_i32 + 2_i32'
stderr 'macro-expanded names'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "extract-variable-rust-attribute-macro-fixture"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
#[test]
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
-- want/lib.rs --
#[test]
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
