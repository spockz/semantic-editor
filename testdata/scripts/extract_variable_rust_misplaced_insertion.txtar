env SEMEDIT_TEST_RUST_EXTRACT_VARIABLE=misplaced
! exec semedit refactor-extract-value --language rust --trust-workspace --file src/lib.rs --symbol total --in-function run --discriminator '1_i32 + 2_i32'
stderr 'invalid rust rename edit'
cmp src/lib.rs want/lib.rs

-- Cargo.toml --
[package]
name = "extract-variable-misplaced-insertion-fixture"
version = "0.1.0"
edition = "2021"
-- src/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
-- want/lib.rs --
fn run() {
    consume(1_i32 + 2_i32);
}

fn consume(value: i32) {}
