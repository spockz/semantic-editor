# MCP metrics text carries complete measurement records and optional session metrics.
stdin input.json
exec semedit mcp
stdout 'Critical result \(JSON\):'
stdout 'completed_at'
stdout 'session_metrics'
stdout 'phases'
stdout 'semantic_verify'
-- go.mod --
module example.com.metricstext

go 1.24
-- main.go --
package metricstext

func Value() int { return 1 }
-- input.json --
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"semantic_verify","arguments":{"path":".","language":"go","check_only":true}}}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"semantic_metrics","arguments":{"limit":1}}}
