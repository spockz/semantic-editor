env SEMEDIT_ASSERT_JAVA_SETTINGS=disabled SEMEDIT_TEST_JAVA_EXTRACT_VARIABLE=1 SEMEDIT_TEST_JAVA_CONSTRUCTS=1
exec semedit extract-variable --language java --trust-workspace --java-bin $SEMEDIT_TEST_JAVA --jdtls-home tools/jdtls --file src/Widget.java --symbol amount --in-function Widget.run() --discriminator '1 + 2'
stdout 'Extracted the Java expression into a local variable'
cmp src/Widget.java want/Widget.java

-- tools/jdtls/plugins/org.eclipse.equinox.launcher_1.0.0.jar --
placeholder

-- tools/jdtls/config_mac/.keep --
placeholder

-- src/Widget.java --
package sample;
class Widget {
  void run() {
    consume(1 + 2);
  }
}
-- want/Widget.java --
package sample;
class Widget {
  void run() {
    int amount = 1 + 2;
    consume(amount);
  }
}
