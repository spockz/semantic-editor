var value int
func hit() {}
func miss() {}
func probe() bool { return true }
func probeValue() int { return 1 }
func consume([]int) {}
func consumeScalar(int) {}
-- constants.go --
package sample

func LocalConstant() {
	const enabled = true
	if enabled { hit() } else { miss() }
}
-- original/constants.go --
package sample

func LocalConstant() {
	const enabled = true
	if enabled { hit() } else { miss() }
}
