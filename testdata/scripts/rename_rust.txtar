# Rust rename is file-scoped and uses the deterministic rust-analyzer stand-in.
exec semedit rename --language rust --trust-workspace --file src/lib.rs --symbol Widget --to Gadget
exec cat src/lib.rs
stdout 'struct Gadget {}'
cmp src/lib.rs want.rs

-- Cargo.toml --
[package]
name = "example"
version = "0.1.0"

-- want.rs --
struct Gadget {}
-- src/lib.rs --
struct Widget {}
