-- nested.go --
package render

func RenderBranch(count int) int {
	if count > 0 {
		return count + 1
	}
	return count
}
-- want/nested.go --
package render

func RenderBranch(count int) int {
	if count > 0 {
		selected := count + 1
		return selected
	}
	return count
}
