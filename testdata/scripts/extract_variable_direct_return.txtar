-- return.go --
package render

func RenderDeferred(count []int) int {
	defer func() { count[0] += 10 }()
	return count[0] + 1
}

var deferredOrder []int

func RenderDefers(count int) int {
	deferredOrder = append(deferredOrder, 1)
	defer func() { deferredOrder = append(deferredOrder, 3) }()
	defer func() { deferredOrder = append(deferredOrder, 2) }()
	return count + 1
}
-- want/return.go --
package render

func RenderDeferred(count []int) int {
	defer func() { count[0] += 10 }()
	selected := count[0] + 1
	return selected
}

var deferredOrder []int

func RenderDefers(count int) int {
	deferredOrder = append(deferredOrder, 1)
	defer func() { deferredOrder = append(deferredOrder, 3) }()
	defer func() { deferredOrder = append(deferredOrder, 2) }()
	selected := count + 1
	return selected
}
-- named.go --
package render

type Metric int

func RenderNamed(value Metric) any {
	return value
}
-- want/named.go --
package render

type Metric int

func RenderNamed(value Metric) any {
	selected := value
	return selected
}
-- panic.go --
package render

var recoveredPanics int

func RenderIndex(values []int, index int) int {
	defer func() {
		if recover() != nil {
			recoveredPanics++
		}
	}()
	return values[index]
}
-- want/panic.go --
package render

var recoveredPanics int

func RenderIndex(values []int, index int) int {
	defer func() {
		if recover() != nil {
			recoveredPanics++
		}
	}()
	selected := values[index]
	return selected
}
-- refusals.go --
package render

func pair(value int) (int, int) { return value, value }

func RenderMultipleResults(count int) (int, int) { return count + 1, count + 2 }
func RenderMultipleNamedResults(count int) (first, second int) { return pair(count) }
func RenderBlankResult(count int) (_ int) { return count + 1 }
func RenderNested(count int) int {
	compute := func() int { return count + 1 }
	return compute()
}
func RenderUntyped() int { return 1 + 2 }
func RenderTuple(count int) (int, int) { return pair(count) }

func RenderNaked(value int) (result int) {
	result = value
	return
}
-- original/refusals.go --
package render

func pair(value int) (int, int) { return value, value }

func RenderMultipleResults(count int) (int, int) { return count + 1, count + 2 }
func RenderMultipleNamedResults(count int) (first, second int) { return pair(count) }
func RenderBlankResult(count int) (_ int) { return count + 1 }
func RenderNested(count int) int {
	compute := func() int { return count + 1 }
	return compute()
}
func RenderUntyped() int { return 1 + 2 }
func RenderTuple(count int) (int, int) { return pair(count) }

func RenderNaked(value int) (result int) {
	result = value
	return
}
