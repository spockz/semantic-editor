package render

func consume(int) {}

func RenderAmbiguous(count int) int {
	consume(count + 1)
	return count + 1
}
-- original/ambiguous.go --
package render

func consume(int) {}

func RenderAmbiguous(count int) int {
	consume(count + 1)
	return count + 1
}
-- want/ambiguous.go --
package render

func consume(int) {}

func RenderAmbiguous(count int) int {
	consume(count + 1)
	selected := count + 1
	return selected
}
-- return_test.go --
package render

import (
	"reflect"
	"testing"
)

func TestReturnExtractionPreservesEvaluationAndDefers(t *testing.T) {
	count := []int{2}
	if got := RenderDeferred(count); got != 3 || count[0] != 12 {
		t.Fatalf("RenderDeferred() = %d with count %d, want result 3 and deferred count 12", got, count[0])
	}
	if got := RenderNamed(Metric(7)); got != Metric(7) || reflect.TypeOf(got) != reflect.TypeOf(Metric(0)) {
		t.Fatalf("RenderNamed() = %v (%T), want Metric(7)", got, got)
	}
	deferredOrder = nil
	if got := RenderDefers(4); got != 5 || !reflect.DeepEqual(deferredOrder, []int{1, 2, 3}) {
		t.Fatalf("RenderDefers() = %d with order %v, want result 5 and order [1 2 3]", got, deferredOrder)
	}
	if got := RenderIndex(nil, 0); got != 0 || recoveredPanics != 1 {
		t.Fatalf("RenderIndex() = %d with recovered panics %d, want result 0 and one recovery", got, recoveredPanics)
	}
}
