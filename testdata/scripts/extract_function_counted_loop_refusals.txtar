# Refuse unsupported loop headers and exits without changing the source.
! exec semedit refactor-extract-callable --file service.go --symbol ownerWrite --in-function OwnerWrite --kind function --start-line 4 --end-line 6
stderr 'loop body statements must be direct calls'
cmp service.go original/service.go
! exec semedit refactor-extract-callable --file service.go --symbol rangeLoop --in-function RangeLoop --kind function --start-line 10 --end-line 10
stderr 'cannot copy non-scalar owner input "values"'
cmp service.go original/service.go
! exec semedit refactor-extract-callable --file service.go --symbol nestedLoop --in-function NestedLoop --kind function --start-line 14 --end-line 16
stderr 'loop body statements must be direct calls'
cmp service.go original/service.go
! exec semedit refactor-extract-callable --file service.go --symbol effectfulHeader --in-function EffectfulHeader --kind function --start-line 20 --end-line 20
stderr 'pure comparison with the index'
cmp service.go original/service.go
! exec semedit refactor-extract-callable --file service.go --symbol labeledExit --in-function LabeledExit --kind function --start-line 24 --end-line 27
stderr 'selected statement on line 24 is not a call'
cmp service.go original/service.go
exec go test ./...

-- go.mod --
module example.com/extractlooprefusals

go 1.23
-- service.go --
package sample

func OwnerWrite(limit int) {
	for i := 0; i < limit; i++ {
		limit--
	}
}

func RangeLoop(values []int) {
	for i := range values { println(i); println(values) }
}

func NestedLoop(limit int) {
	for i := 0; i < limit; i++ {
		for j := 0; j < limit; j++ { println(j) }
	}
}

func EffectfulHeader() {
	for i := 0; i < nextLimit(); i++ { println(i) }
}

func LabeledExit(limit int) {
outer:
	for i := 0; i < limit; i++ {
		break outer
	}
}

func nextLimit() int { return 1 }
-- original/service.go --
package sample

func OwnerWrite(limit int) {
	for i := 0; i < limit; i++ {
		limit--
	}
}

func RangeLoop(values []int) {
	for i := range values { println(i); println(values) }
}

func NestedLoop(limit int) {
	for i := 0; i < limit; i++ {
		for j := 0; j < limit; j++ { println(j) }
	}
}

func EffectfulHeader() {
	for i := 0; i < nextLimit(); i++ { println(i) }
}

func LabeledExit(limit int) {
outer:
	for i := 0; i < limit; i++ {
		break outer
	}
}

func nextLimit() int { return 1 }
