# Test sentinel-error aware declaration insertion with alphabetical grouping
exec semedit insert-decl --file api/errs.go --source 'var ErrAlpha = errors.New("alpha")'
exec semedit insert-decl --file api/plain.go --source 'var ErrMike = errors.New("mike")'
exec semedit insert-decl --file api/plain.go --source 'var Patch = 3'
exec semedit insert-decl --file api/noblock.go --source 'var ErrSolo = errors.New("solo")'
exec semedit insert-decl --file api/documented.go --source '/* ErrTango documents the tango error. */ var ErrTango = "tango"'
cmp api/errs.go want/api/errs.go
cmp api/plain.go want/api/plain.go
cmp api/noblock.go want/api/noblock.go
cmp api/documented.go want/api/documented.go
exec go test ./...

-- go.mod --
module example.com/test
go 1.23

-- api/errs.go --
package api

import "errors"

var (
	ErrBravo = errors.New("bravo")
)

var Version = "1.0"

-- api/plain.go --
package api

var Revision = "1.0"


-- api/documented.go --
package api

var (
	// ErrZulu documents the zulu error.
	ErrZulu = "zulu"
)

-- want/api/documented.go --
package api

var (
	/* ErrTango documents the tango error. */ ErrTango = "tango"
	// ErrZulu documents the zulu error.
	ErrZulu = "zulu"
)
-- api/noblock.go --
package api

import "fmt"

type Server struct{}

func (s *Server) Start() {
	fmt.Println("start")
}

-- want/api/errs.go --
package api

import "errors"

var (
	ErrAlpha = errors.New("alpha")
	ErrBravo = errors.New("bravo")
)

var Version = "1.0"
-- want/api/plain.go --
package api

import "errors"

var Patch = 3

var ErrMike = errors.New("mike")

var Revision = "1.0"
-- want/api/noblock.go --
package api

import (
	"errors"
	"fmt"
)

var ErrSolo = errors.New("solo")

type Server struct{}

func (s *Server) Start() {
	fmt.Println("start")
}
