# Bash outline preserves the flat selected-file declarations from the server.
exec semedit outline --language bash --trust-workspace --bash-bin $SEMEDIT_TEST_BASH_LS --path tool.sh
stdout 'tool\.sh:[0-9]+.*function f'
cmp tool.sh want.sh

-- tool.sh --
#!/usr/bin/env bash
f() { echo safe; }
-- want.sh --
#!/usr/bin/env bash
f() { echo safe; }
