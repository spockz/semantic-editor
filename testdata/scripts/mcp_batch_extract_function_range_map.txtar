# Extract named map ranges in one buffered batch and prove runtime behavior without assuming iteration order.
stdin input.json
exec semedit mcp --enable-batching
stdout '"isError":false'
stdout '"status":"applied_working"'
cmp service.go .scratch/want/service.go
exec go test ./...

