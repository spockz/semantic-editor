--- a/zrpc/server.go
+++ b/zrpc/server.go
@@ -41,7 +41,11 @@ func NewServer(c RpcServerConf, register internal.RegisterFn) (*RpcServer, error
 	serverOptions := []internal.ServerOption{internal.WithMetrics(metrics), internal.WithMaxRetries(c.MaxRetries)}
 
 	if c.HasEtcd() {
+		if c.Etcd.EnableAuth(){
+			server, err = internal.NewRpcPubServerWithEtcdAuth(c.Etcd.Hosts, c.Etcd.User, c.Etcd.Pass, c.Etcd.Key, c.ListenOn, )
+		} else {
 		server, err = internal.NewRpcPubServer(c.Etcd.Hosts, c.Etcd.Key, c.ListenOn, serverOptions...)
+		}
 		if err != nil {
 			return nil, err
 		}

-- .benchmark/explicit.md --
# Exact semedit recipe: zeromicro__go-zero-964

Implement etcd RBAC authentication for discovery configuration. Preserve the existing unauthenticated behavior. A credential pair is valid only when both user and password are present; route authenticated RPC server registration through the authenticated publisher while preserving server options.

The workspace is the pinned go-zero checkout at commit 68acfb1891837ec2e401588173cdd16ca1b9a9c4. All file paths are relative to that workspace root.

Make exactly one semantic tool call: semantic_batch. Do not make preliminary semantic calls or additional edits. Execute the ordered children with the exact parameters below. Stop and report any tool failure. After the batch succeeds, output DONE.

