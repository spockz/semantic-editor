task_id: task-01-rename-local
category: mechanics
instruction: "Rename the unexported method Server.oldName to Server.newName and update all call-sites."
verification_constraint: "Verify your changes and ensure 'go test ./...' passes with zero errors before concluding."
interactive_followups:
  - "Inspect the declaration of the requested method and correct its API name if it still differs from the task."
  - "Inspect every caller of that method in the fixture and make their invocation consistent with its requested API."
  - "In api/server.go, rename the Server.oldName declaration to newName and change Run to call s.newName(), then run go test ./...."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "api/server_test.go"
  level_2_ast:
    file: "api/server.go"
    must_contain_symbols:
      - "Server.newName"
    must_not_contain_symbols:
      - "Server.oldName"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct{}

func (s *Server) oldName() string {
	return "ok"
}

func Run() string {
	s := &Server{}
	return s.oldName()
}

-- api/server_test.go --
package api

import "testing"

func TestRun(t *testing.T) {
	s := Run()
	if s != "ok" {
		t.Fatalf("expected ok, got %s", s)
	}
}
