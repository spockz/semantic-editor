task_id: task-01-rename-local
category: mechanics
instruction: "Rename the unexported method Server.oldName to Server.newName and update all call-sites."
contexts:
  - small
  - large
verification_constraint: "Verify your changes and ensure 'go test ./...' passes with zero errors before concluding."
interactive_followups:
  - "This is a rename of the existing unexported Server method. Preserve its receiver, signature, and behavior; the oldName method should no longer exist alongside newName."
  - "Update every call to that method in the api package, including Run. Run must continue to return `ok` through the renamed method; unrelated names and behavior should stay unchanged."
  - "Acceptance behavior: Server.newName replaces Server.oldName in api/server.go, all callers use the new name, and Run still returns `ok`. Preserve tests and module metadata, then run go test ./... and ensure all tests pass before concluding."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "api/server_test.go"
  level_2_ast:
    file: "api/server.go"
    must_contain_symbols:
      - "Server.newName"
    must_not_contain_symbols:
      - "Server.oldName"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct{}

func (s *Server) oldName() string {
	return "ok"
}

func Run() string {
	s := &Server{}
	return s.oldName()
}

-- api/server_test.go --
package api

import "testing"

func TestRun(t *testing.T) {
	s := Run()
	if s != "ok" {
		t.Fatalf("expected ok, got %s", s)
	}
}
