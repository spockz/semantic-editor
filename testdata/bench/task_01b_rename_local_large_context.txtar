-- api/middleware.go --
package api

import "time"

type MiddlewareFunc func(path string, start time.Time) bool

func LoggerMiddleware(path string, start time.Time) bool {
	return len(path) > 0 && !start.IsZero()
}

-- auth/token.go --
package auth

import "errors"

var ErrInvalidToken = errors.New("invalid authentication token")

type TokenValidator struct {
	SecretKey string
}

func NewValidator(key string) *TokenValidator {
	return &TokenValidator{SecretKey: key}
}

func (v *TokenValidator) Validate(tok string) (bool, error) {
	if tok == "" {
		return false, ErrInvalidToken
	}
	return len(tok) > 8, nil
}

-- auth/session.go --
package auth

import "time"

type Session struct {
	ID        string
	UserID    int64
	ExpiresAt time.Time
}

func (s *Session) IsExpired() bool {
	return time.Now().After(s.ExpiresAt)
}

-- auth/permissions.go --
package auth

type Role string

const (
	RoleAdmin Role = "admin"
	RoleUser  Role = "user"
)

func HasPermission(r Role, action string) bool {
	if r == RoleAdmin {
		return true
	}
	return action == "read"
}

-- config/config.go --
package config

type Config struct {
	Environment string
	Port        int
	Debug       bool
