func (u *User) DisplayName() string {
	if u.Name != "" {
		return u.Name
	}
	return u.Email
}

-- models/account.go --
package models

type Account struct {
	AccountID string
	Balance   int64
	Active    bool
}

func (a *Account) CanDebit(amount int64) bool {
	return a.Active && a.Balance >= amount
}

-- models/validator.go --
package models

import "strings"

func ValidateEmail(email string) bool {
	return strings.Contains(email, "@") && strings.Contains(email, ".")
}

-- logging/logger.go --
package logging

type Level int

const (
	LevelDebug Level = iota
	LevelInfo
	LevelWarn
	LevelError
)

type Logger struct {
	MinLevel Level
}

func (l *Logger) IsEnabled(lvl Level) bool {
	return lvl >= l.MinLevel
}

-- logging/formatter.go --
package logging

import "fmt"

func FormatMessage(prefix, msg string) string {
	return fmt.Sprintf("[%s] %s", prefix, msg)
}

-- utils/strings.go --
package utils

import "strings"

func Truncate(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen] + "..."
}

func Capitalize(s string) string {
	if len(s) == 0 {
		return ""
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

-- utils/math.go --
package utils

func ClampInt(val, min, max int) int {
	if val < min {
		return min
	}
	if val > max {
		return max
	}
	return val
}

-- health/checker.go --
package health

type Status string

const (
	StatusHealthy   Status = "HEALTHY"
	StatusDegraded  Status = "DEGRADED"
	StatusUnhealthy Status = "UNHEALTHY"
)

type CheckResult struct {
	Component string
	Status    Status
}

func Aggregate(checks []CheckResult) Status {
	for _, c := range checks {
		if c.Status == StatusUnhealthy {
			return StatusUnhealthy
		}
	}
	return StatusHealthy
}

