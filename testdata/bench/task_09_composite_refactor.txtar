task_id: task-09-composite-refactor
category: composition
instruction: "In config/config.go: rename Config.Port to Config.ListenPort, insert helper function DefaultConfig() *Config returning default values, and clean up unused imports."
prompt_variants:
  default: "In config/config.go: rename Config.Port to Config.ListenPort, insert helper function DefaultConfig() *Config returning default values, and clean up unused imports."
interactive_followups:
  - "Review the Config field migration and make the requested field name consistent at its declaration and uses."
  - "Add the requested default-config helper if it is absent, choosing values that make the package's visible configuration behavior usable."
  - "Review config/config.go imports and remove dependencies that the completed implementation no longer uses."
  - "In config/config.go, rename Config.Port and c.Port to ListenPort, add DefaultConfig returning &Config{Host: \"localhost\", ListenPort: 8080}, remove archive/tar, and run go test ./...."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "config/config_test.go"
  level_2_ast:
    file: "config/config.go"
    must_contain_symbols:
      - "Config.ListenPort"
      - "DefaultConfig"
    must_not_contain_symbols:
      - "Config.Port"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- config/config.go --
package config

import (
	"archive/tar"
	"fmt"
)

type Config struct {
	Host string
	Port int
}

func (c *Config) Addr() string {
	return fmt.Sprintf("%s:%d", c.Host, c.Port)
}

-- config/config_test.go --
package config

import "testing"

func TestDefaultConfig(t *testing.T) {
	c := DefaultConfig()
	if c == nil {
		t.Fatal("expected non-nil config")
	}
	if c.ListenPort == 0 {
		c.ListenPort = 8080
	}
	if c.Host == "" {
		c.Host = "localhost"
	}
	if c.Addr() != "localhost:8080" {
		t.Fatalf("expected localhost:8080, got %s", c.Addr())
	}
}
