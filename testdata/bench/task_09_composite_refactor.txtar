task_id: task-09-composite-refactor
category: composition
instruction: "In config/config.go: rename Config.Port to Config.ListenPort, insert DefaultConfig() *Config returning Host localhost and ListenPort 8080, and clean up unused imports."
contexts:
  - small
  - large
prompt_variants:
  default: "In config/config.go: rename Config.Port to Config.ListenPort, insert DefaultConfig() *Config returning Host localhost and ListenPort 8080, and clean up unused imports."
interactive_followups:
  - "Rename the Config field from Port to ListenPort and update its uses, including Addr. Addr must continue to format the configured Host and port; unrelated Port fields in other packages are outside this change."
  - "DefaultConfig() *Config should return a non-nil configuration with Host set to `localhost` and ListenPort set to 8080, so its Addr() is `localhost:8080` without caller initialization."
  - "Clean up imports left unused in config/config.go while preserving Addr behavior for caller-supplied host and port values, not just the defaults."
  - "Acceptance behavior: Config exposes ListenPort instead of Port; DefaultConfig() *Config supplies Host `localhost` and ListenPort 8080; and Addr formats the current configuration values. Remove unused imports, preserve tests and module metadata, then run go test ./... and ensure all tests pass before concluding."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "config/config_test.go"
  level_2_ast:
    file: "config/config.go"
    must_contain_symbols:
      - "Config.ListenPort"
      - "DefaultConfig"
    must_not_contain_symbols:
      - "Config.Port"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- config/config.go --
package config

import (
	"archive/tar"
	"fmt"
)

type Config struct {
	Host string
	Port int
}

func (c *Config) Addr() string {
	return fmt.Sprintf("%s:%d", c.Host, c.Port)
}

-- config/config_test.go --
package config

import "testing"

func TestDefaultConfig(t *testing.T) {
	c := DefaultConfig()
	if c == nil {
		t.Fatal("expected non-nil config")
	}
	if c.Host != "localhost" {
		t.Errorf("expected default host localhost, got %q", c.Host)
	}
	if c.ListenPort != 8080 {
		t.Errorf("expected default listen port 8080, got %d", c.ListenPort)
	}
	if got := c.Addr(); got != "localhost:8080" {
		t.Errorf("expected localhost:8080, got %s", got)
	}
	c.Host = "example.test"
	c.ListenPort = 9090
	if got := c.Addr(); got != "example.test:9090" {
		t.Errorf("expected example.test:9090, got %s", got)
	}
}
