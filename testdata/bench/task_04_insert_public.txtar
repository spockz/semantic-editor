task_id: task-04-insert-public
category: mechanics
instruction: "Add public constructor func InitServer() *Server placed before private helpers."
contexts:
  - small
  - large
prompt_variants:
  default: "Add public constructor func InitServer() *Server placed before private helpers."
interactive_followups:
  - "InitServer must be callable without arguments and return a non-nil *Server. No new configuration arguments or server startup behavior are required."
  - "Place the exported constructor in api/server.go before the private helper methods, including Server.internalRun. Preserve the existing Server type and method behavior."
  - "Acceptance behavior: func InitServer() *Server returns a non-nil server and is declared before Server.internalRun in api/server.go. Preserve tests and module metadata, then run go test ./... and ensure all tests pass before concluding."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "api/server_test.go"
  level_2_ast:
    file: "api/server.go"
    must_contain_symbols:
      - "InitServer"
    symbol_before:
      first: "InitServer"
      second: "Server.internalRun"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct {
	Port int
}

func (s *Server) Start() {}

func (s *Server) internalRun() {}

-- api/server_test.go --
package api

import "testing"

func TestInitServer(t *testing.T) {
	s := InitServer()
	if s == nil {
		t.Fatal("expected non-nil server")
	}
}
