task_id: task-04-insert-public
category: mechanics
instruction: "Add public constructor func InitServer() *Server placed before private helpers."
prompt_variants:
  default: "Add public constructor func InitServer() *Server placed before private helpers."
interactive_followups:
  - "Add the requested exported constructor if api/server.go still lacks it; ensure it returns a usable server instance."
  - "Review declaration placement and move the constructor into the public section before private helpers."
  - "In api/server.go, insert func InitServer() *Server { return &Server{} } before func (s *Server) internalRun(), then run go test ./...."
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "api/server_test.go"
  level_2_ast:
    file: "api/server.go"
    must_contain_symbols:
      - "InitServer"
    symbol_before:
      first: "InitServer"
      second: "Server.internalRun"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct {
	Port int
}

func (s *Server) Start() {}

func (s *Server) internalRun() {}

-- api/server_test.go --
package api

import "testing"

func TestInitServer(t *testing.T) {
	s := InitServer()
	if s == nil {
		t.Fatal("expected non-nil server")
	}
}
