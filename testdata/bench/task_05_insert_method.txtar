task_id: task-05-insert-method
category: mechanics
instruction: "Add a new method func (s *Server) Stop() after Server.Start."
prompt_variants:
  explicit: "Call semantic_lookup with {\"file\":\"api/server.go\",\"symbol\":\"Server.Start\"}. Then call semantic_insert_function with {\"file\":\"api/server.go\",\"source\":\"func (s *Server) Stop() { s.running = false }\",\"placement\":\"after_symbol\",\"target_symbol\":\"Server.Start\"}. Do not alter Start or unrelated code."
contexts:
  - small
  - large
oracle:
  level_1_mutation_policy:
    disallowed_files:
      - "go.mod"
      - "go.sum"
      - "api/server_test.go"
  level_2_ast:
    file: "api/server.go"
    must_contain_symbols:
      - "Server.Stop"
    symbol_before:
      first: "Server.Start"
      second: "Server.Stop"
  level_3_build:
    clean_compile: true
  level_4_test:
    pass_tests: true
-- go.mod --
module example.com/test
go 1.23

-- api/server.go --
package api

type Server struct {
	running bool
}

func (s *Server) Start() {
	s.running = true
}

func (s *Server) IsRunning() bool {
	return s.running
}

-- api/server_test.go --
package api

import "testing"

func TestServerStop(t *testing.T) {
	s := &Server{}
	s.Start()
	if !s.IsRunning() {
		t.Fatal("expected server running")
	}
	s.Stop()
}
