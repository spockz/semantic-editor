{
  "mcpServers": {
    "gopls": {
      "command": "gopls",
      "args": [
        "mcp"
      ]
    },
    "markdown": {
      "command": "marksman",
      "args": [
        "server"
      ]
    },
    "semedit": {
      "command": "{{SEMEDIT_BINARY}}",
      "args": [
        "mcp",
        "--profile=full",
        "--live-reload"
      ]
    },
    "semedit-next": {
      "command": "{{SEMEDIT_NEXT_BINARY}}",
      "args": [
        "mcp",
        "--profile=full",
        "--live-reload"
      ]
    }
  }
}
