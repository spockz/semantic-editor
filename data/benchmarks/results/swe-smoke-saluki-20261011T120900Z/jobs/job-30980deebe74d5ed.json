              "newString": "// GetConn returns an etcd client connection associated with given config.\nfunc (r *Registry) GetConn(c clientv3.Config) (EtcdClient, error) {\n\treturn r.getCluster(c).getClient()\n}\n\n// Monitor monitors the key on given etcd config, notify with the given UpdateListener.\nfunc (r *Registry) Monitor(c clientv3.Config, key string, l UpdateListener) error {\n\treturn r.getCluster(c).monitor(key, l)\n}\n\nfunc (r *Registry) getCluster(c clientv3.Config) *cluster {\n\tclusterKey := getClusterKey(c)\n\tr.lock.Lock()\n\tdefer r.lock.Unlock()\n\tcl, ok := r.clusters[clusterKey]\n\tif !ok {\n\t\tcl = newCluster(c)\n\t\tr.clusters[clusterKey] = cl\n\t}\n\n\treturn cl\n}\n\ntype cluster struct {\n\tconfig     clientv3.Config\n\tkey        string\n\tvalues     map[string]map[string]string\n\tlisteners  map[string][]UpdateListener\n\twatchGroup *threading.RoutineGroup\n\tdone       chan lang.PlaceholderType\n\tlock       sync.Mutex\n}\n\nfunc newCluster(c clientv3.Config) *cluster {\n\treturn \u0026cluster{\n\t\tconfig:     c,\n\t\tkey:        getClusterKey(c),\n\t\tvalues:     make(map[string]map[string]string),\n\t\tlisteners:  make(map[string][]UpdateListener),\n\t\twatchGroup: threading.NewRoutineGroup(),\n\t\tdone:       make(chan lang.PlaceholderType),\n\t}\n}",
