            "arguments": {
              "CodeContent": "\"// Package audit groups delivery kinds for operational reporting.\\npackage audit\\n\\nfunc Classify(kind string) string {\\n\\tswitch NormalizeKind(kind) {\\n\\tcase \\\"health\\\", \\\"probe\\\":\\n\\t\\treturn \\\"control\\\"\\n\\tdefault:\\n\\t\\treturn \\\"data\\\"\\n\\t}\\n}\\n\"",
              "Description": "\"Update Classify to classify normalized probe events as control traffic, like health\"",
