              "CodeContent": "\"// Package audit leaves room for normalization rules owned by the delivery boundary.\\npackage audit\\n\\nimport \\\"strings\\\"\\n\\n// NormalizeKind strips surrounding whitespace and lowercases the kind.\\nfunc NormalizeKind(kind string) string {\\n\\treturn strings.ToLower(strings.TrimSpace(kind))\\n}\\n\"",
